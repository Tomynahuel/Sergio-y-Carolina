---
// Importamos los estilos globales y todos los componentes visuales
import '../styles/global.css';
import Presentacion from '../components/Presentacion.astro';
import Bienvenida from '../components/Bienvenida.astro';
import ConfirmaAsistencia from '../components/ConfirmaAsistencia.astro';
import RSVP from '../components/RSVP.astro';
import Contacto from '../components/Contacto.astro';

// Calculamos la ruta de la imagen para que funcione tanto local como en GitHub Pages
const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;

---

<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ingreso - Boda Sergio y Carolina</title>
</head>
<body class="bg-ivory font-serif text-botanical m-0 p-0">
  
  <div class="flex flex-col lg:flex-row min-h-screen w-full relative">
    
    <div class="w-full lg:w-1/2 h-[40vh] lg:h-screen lg:sticky lg:top-0 bg-cover bg-center flex items-center justify-center" >
        <Presentacion />
    </div>

    <div class="w-full lg:w-1/2 flex flex-col justify-start items-center p-8 py-12 gap-10 bg-ivory min-h-screen overflow-x-hidden">
      
        <Bienvenida />
        <ConfirmaAsistencia />
        <RSVP />
        <Contacto />

        
    </div>

  </div>
</body>
</html>