---
import '../styles/global.css';
import { Image } from 'astro:assets';

import { BODA_INFO } from '../data/InfoBoda.js';

import Presentacion from '../components/Presentacion.astro';
import Bienvenida from '../components/Bienvenida.astro';
import ConfirmaAsistencia from '../components/ConfirmaAsistencia.astro';
import RSVP from '../components/RSVP.astro';
import Contacto from '../components/Contacto.astro';
import ResuInfo from '../components/InfoResu.astro';
// import DecoInvitacion from '../components/deco-invitacion.astro';
import Sobre from '../components/Sobre.astro';
---

<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Boda {BODA_INFO.nombres}</title>
</head>

<body
  class="m-0 min-h-screen bg-[var(--color-fondo)] p-0 font-serif text-[var(--color-texto)]"
>

  <!-- <Sobre /> -->

  <!-- =====================================================
       HEADER
       ===================================================== -->

  <header
    class="fixed top-0 z-50 w-full border-b border-[var(--color-borde-suave)] bg-[var(--color-superficie)] backdrop-blur-md"
    x-data="{ open: false }"
  >

    <div
      class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
    >

      <!-- LOGO -->

      <a
        href="/Sergio-y-Carolina/invitacion"
        class="flex items-center gap-2 font-serif text-3xl font-semibold tracking-[0.2em] text-[var(--color-principal)]"
      >
        <span>S</span>

        <Image
          src={BODA_INFO.anillos}
          alt="Anillo"
          class="h-12 w-12 object-contain"
        />

        <span>C</span>
      </a>

      <!-- BOTÓN MOBILE -->

      <button
        @click="open = !open"
        class="text-3xl text-[var(--color-principal)] lg:hidden"
        aria-label="Abrir menú"
      >
        ☰
      </button>

      <!-- MENÚ DESKTOP -->

      <nav class="hidden gap-8 lg:flex">

        <a
          href="/Sergio-y-Carolina/"
          class="text-sm uppercase tracking-[0.15em] text-[var(--color-texto)] transition hover:text-[var(--color-acento)]"
        >
          Inicio
        </a>

        <a
          href="/Sergio-y-Carolina/invitacion/"
          class="text-sm uppercase tracking-[0.15em] text-[var(--color-texto)] transition hover:text-[var(--color-acento)]"
        >
          Invitación
        </a>

      </nav>

    </div>


    <!-- =====================================================
         MENÚ MOBILE
         ===================================================== -->

    <div x-show="open" x-transition class="lg:hidden">

      <div
        class="border-t border-[var(--color-borde-suave)] bg-[var(--color-superficie)] px-4 py-4 backdrop-blur-sm"
      >

        <div
          class="flex flex-col gap-2 text-sm uppercase tracking-[0.15em] text-[var(--color-texto)]"
        >

          <a
            href="/Sergio-y-Carolina/"
            class="block rounded-full px-4 py-3 transition hover:bg-[var(--color-acento-suave)]"
          >
            Inicio
          </a>

          <a
            href="/Sergio-y-Carolina/invitacion/"
            class="block rounded-full px-4 py-3 transition hover:bg-[var(--color-acento-suave)]"
          >
            Invitación
          </a>

        </div>

      </div>

    </div>

  </header>


  <!-- =====================================================
       CONTENIDO PRINCIPAL
       ===================================================== -->

  <div
    class="relative flex min-h-screen w-full flex-col lg:flex-row"
  >

    <!-- ===================================================
         COLUMNA IZQUIERDA — PRESENTACIÓN
         =================================================== -->

    <div
      class="relative flex min-h-[100svh] w-full items-center justify-center bg-cover bg-center pt-20 lg:sticky lg:top-0 lg:h-screen lg:w-1/2"
      style={`background-image: url('${BODA_INFO.presentacion}');`}
    >

      <!-- Overlay -->

      <div
        class="absolute inset-0 bg-[var(--color-sombra-fondo-suave)] lg:hidden"
      ></div>

      <!-- Presentación -->

      <div
        class="relative z-10 flex w-full flex-col items-center justify-center"
      >
        <Presentacion />
      </div>

    </div>


    <!-- ===================================================
         COLUMNA DERECHA — INFORMACIÓN
         =================================================== -->

    <div
      class="relative flex min-h-screen w-full flex-col items-center justify-start gap-10 bg-[var(--color-fondo)] px-6 pb-12 pt-24 lg:w-1/2 lg:px-12 lg:pb-12 lg:pt-28"
    >

      <Bienvenida />

      <ResuInfo />

      <ConfirmaAsistencia />

      <RSVP />

      <Contacto />

    </div>

  </div>

</body>
</html>