---
import { Image } from "astro:assets";
import { BODA_INFO } from "../data/InfoBoda.js";
import { ClientRouter } from "astro:transitions";

import "../styles/global.css";

const { title } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const musicaAmbiente = `${baseUrl}mus/ambiente.mp3`;
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Sergio y Carolina te invitan a celebrar su boda con una experiencia elegante y emotiva."
    />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <script
      defer
      src="https://cdn.jsdelivr.net/npm/alpinejs@3.12.0/dist/cdn.min.js"
    ></script>

    <ClientRouter />
  </head>

  <body
    class="min-h-screen bg-[var(--color-fondo)] text-[var(--color-texto)] leading-relaxed antialiased"
  >
    <!-- =====================================================
         HEADER
         ===================================================== -->

    <header
      id="main-header"
      class="fixed top-0 z-50 w-full border-b border-[var(--color-borde-suave)] bg-[var(--color-superficie)] backdrop-blur-md transition-transform duration-300 ease-in-out"
    >
      <div
        class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
      >
        <!-- LOGO -->

        <a
          href="#home"
          class="flex items-center gap-2 text-[var(--color-principal)]"
          aria-label="Inicio"
        >
          <Image
            src={BODA_INFO.anillos}
            alt="Anillos de boda"
            class="h-12 w-12 object-contain sm:h-14 sm:w-14"
          />
        </a>

        <!-- BOTÓN MOBILE -->

        <button
          id="mobile-menu-button"
          type="button"
          class="text-3xl text-[var(--color-principal)] lg:hidden"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          ☰
        </button>

        <!-- MENÚ DESKTOP -->

        <nav
          class="hidden gap-8 lg:flex"
          aria-label="Navegación principal"
        >
          <a
            href="#home"
            class="font-parrafo text-sm uppercase tracking-[0.15em] text-[var(--color-texto)] transition hover:text-[var(--color-acento)]"
          >
            Inicio
          </a>

          <a
            href="#story"
            class="font-parrafo text-sm uppercase tracking-[0.15em] text-[var(--color-texto)] transition hover:text-[var(--color-acento)]"
          >
            Nuestra historia
          </a>

          <a
            href="#itinerary"
            class="font-parrafo text-sm uppercase tracking-[0.15em] text-[var(--color-texto)] transition hover:text-[var(--color-acento)]"
          >
            Cronograma
          </a>

          <a
            href="#gallery"
            class="font-parrafo text-sm uppercase tracking-[0.15em] text-[var(--color-texto)] transition hover:text-[var(--color-acento)]"
          >
            Galería
          </a>

          <a
            id="nav-confirmar-asistencia"
            href="#rsvp"
            class="font-parrafo text-sm uppercase tracking-[0.15em] text-[var(--color-texto)] transition hover:text-[var(--color-acento)]"
          >
            Confirmar asistencia
          </a>
        </nav>
      </div>

      <!-- ===================================================
           MENÚ MOBILE
           =================================================== -->

      <div
        id="mobile-menu"
        class="hidden lg:hidden"
      >
        <div
          class="border-t border-[var(--color-borde-suave)] bg-[var(--color-superficie)] px-4 py-4 backdrop-blur-sm"
        >
          <nav
            class="flex flex-col gap-2 text-sm uppercase tracking-[0.15em] text-[var(--color-texto)]"
            aria-label="Navegación móvil"
          >
            <a
              href="#home"
              class="font-parrafo block rounded-full px-4 py-3 transition hover:bg-[var(--color-acento-suave)]"
            >
              Inicio
            </a>

            <a
              href="#story"
              class="font-parrafo block rounded-full px-4 py-3 transition hover:bg-[var(--color-acento-suave)]"
            >
              Nuestra historia
            </a>

            <a
              href="#itinerary"
              class="font-parrafo block rounded-full px-4 py-3 transition hover:bg-[var(--color-acento-suave)]"
            >
              Cronograma
            </a>

            <a
              href="#gallery"
              class="font-parrafo block rounded-full px-4 py-3 transition hover:bg-[var(--color-acento-suave)]"
            >
              Galería
            </a>

            <a
              id="nav-confirmar-asistencia-mobile"
              href="#rsvp"
              class="font-parrafo block rounded-full px-4 py-3 transition hover:bg-[var(--color-acento-suave)]"
            >
              Confirmar asistencia
            </a>
          </nav>
        </div>
      </div>
    </header>

    <!-- =====================================================
         CONTENIDO
         ===================================================== -->

    <main>
      <slot />
    </main>

    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer
      class="border-t border-[var(--color-borde-suave)] bg-[var(--color-superficie-media)] py-10"
    >
      <div
        class="section-shell flex flex-col items-center justify-between gap-4 text-center text-sm text-[var(--color-texto-suave)] sm:flex-row"
      >
        <p>
          © 2026 Sergio y Carolina. Gracias por acompañarnos.
        </p>

        <p>
          Con amor, siempre.
        </p>
      </div>
    </footer>

    <!-- =====================================================
         MÚSICA
         ===================================================== -->

    <div
      id="music-player"
      class="fixed bottom-5 right-5 z-50"
    >
      <audio
        id="ambient-audio"
        src={musicaAmbiente}
        loop
        preload="auto"
      ></audio>

      <button
        id="music-toggle"
        type="button"
        class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-principal)] text-[var(--color-blanco)] shadow-lg transition hover:bg-[var(--color-principal-hover)]"
        aria-label="Reproducir música"
      >
        <span
          id="music-icon"
          class="text-xl"
          aria-hidden="true"
        >
          ▶
        </span>
      </button>
    </div>

    <!-- =====================================================
         SCRIPTS
         ===================================================== -->

    <script>
      /*
       * =====================================================
       * MÚSICA AMBIENTE
       * =====================================================
       *
       * La música se inicia cuando el usuario interactúa
       * con la página.
       *
       * Esto permite que el primer toque del sobre pueda
       * iniciar la música sin ser bloqueado por el navegador.
       */

      const audio = document.getElementById(
        "ambient-audio",
      );

      const musicButton = document.getElementById(
        "music-toggle",
      );

      const musicIcon = document.getElementById(
        "music-icon",
      );

      let musicaReproduciendo = false;

      function actualizarControlMusica() {
        if (!audio || !musicIcon || !musicButton) return;

        if (!audio.paused) {
          musicaReproduciendo = true;

          musicIcon.textContent = "⏸";

          musicButton.setAttribute(
            "aria-label",
            "Pausar música",
          );
        } else {
          musicaReproduciendo = false;

          musicIcon.textContent = "▶";

          musicButton.setAttribute(
            "aria-label",
            "Reproducir música",
          );
        }
      }

      /*
       * Esta función queda disponible globalmente.
       *
       * Tu Sobre.astro puede ejecutar:
       *
       * window.iniciarMusica();
       *
       * justo cuando el invitado toca el sobre.
       */

      window.iniciarMusica = function () {
        if (!audio) return;

        audio
          .play()
          .then(() => {
            musicaReproduciendo = true;

            actualizarControlMusica();
          })
          .catch(() => {
            /*
             * El navegador todavía puede bloquear el audio.
             * En ese caso no hacemos nada y esperamos otra
             * interacción del usuario.
             */
          });
      };

      /*
       * Botón manual de música.
       */

      if (musicButton && audio) {
        musicButton.addEventListener(
          "click",
          () => {
            if (audio.paused) {
              window.iniciarMusica();
            } else {
              audio.pause();
            }
          },
        );
      }

      /*
       * Mantener el estado del botón sincronizado.
       */

      if (audio) {
        audio.addEventListener(
          "play",
          actualizarControlMusica,
        );

        audio.addEventListener(
          "pause",
          actualizarControlMusica,
        );

        audio.addEventListener(
          "ended",
          actualizarControlMusica,
        );
      }

      /*
       * Intento de autoplay.
       *
       * Algunos navegadores lo permiten.
       * Si no lo permiten, no genera ningún error.
       */

      if (audio) {
        audio
          .play()
          .then(() => {
            actualizarControlMusica();
          })
          .catch(() => {
            /*
             * Autoplay bloqueado.
             *
             * Se iniciará mediante la primera interacción
             * del usuario.
             */
          });
      }

      /*
       * =====================================================
       * RSVP
       * =====================================================
       */

      const rsvpStorageKey = "sergio-y-carolina-rsvp";

      function actualizarBotonConfirmacion() {
        const confirmarDesktop = document.getElementById(
          "nav-confirmar-asistencia",
        );

        const confirmarMobile = document.getElementById(
          "nav-confirmar-asistencia-mobile",
        );

        const yaConfirmo =
          window.localStorage.getItem(rsvpStorageKey) ===
          "confirmed";

        if (yaConfirmo) {
          if (confirmarDesktop) {
            confirmarDesktop.remove();
          }

          if (confirmarMobile) {
            confirmarMobile.remove();
          }
        }
      }

      actualizarBotonConfirmacion();

      document.addEventListener(
        "astro:page-load",
        actualizarBotonConfirmacion,
      );

      /*
       * =====================================================
       * HEADER / SCROLL
       * =====================================================
       */

      let lastScrollY = window.scrollY;

      const header =
        document.getElementById("main-header");

      const mobileMenu =
        document.getElementById("mobile-menu");

      const mobileButton =
        document.getElementById(
          "mobile-menu-button",
        );

      function handleHeaderScroll() {
        if (!header) return;

        const currentScrollY = window.scrollY;

        if (currentScrollY <= 50) {
          header.classList.remove("-translate-y-full");

          lastScrollY = currentScrollY;

          return;
        }

        if (currentScrollY > lastScrollY) {
          header.classList.add("-translate-y-full");

          if (mobileMenu) {
            mobileMenu.classList.add("hidden");
          }

          if (mobileButton) {
            mobileButton.setAttribute(
              "aria-expanded",
              "false",
            );
          }
        } else if (currentScrollY < lastScrollY) {
          header.classList.remove("-translate-y-full");
        }

        lastScrollY = currentScrollY;
      }

      window.addEventListener(
        "scroll",
        handleHeaderScroll,
        {
          passive: true,
        },
      );

      /*
       * =====================================================
       * MENÚ MOBILE
       * =====================================================
       */

      if (mobileButton && mobileMenu) {
        mobileButton.addEventListener(
          "click",
          () => {
            const abierto =
              !mobileMenu.classList.contains("hidden");

            if (abierto) {
              mobileMenu.classList.add("hidden");

              mobileButton.setAttribute(
                "aria-expanded",
                "false",
              );

              mobileButton.setAttribute(
                "aria-label",
                "Abrir menú",
              );
            } else {
              mobileMenu.classList.remove("hidden");

              mobileButton.setAttribute(
                "aria-expanded",
                "true",
              );

              mobileButton.setAttribute(
                "aria-label",
                "Cerrar menú",
              );
            }
          },
        );

        mobileMenu
          .querySelectorAll("a")
          .forEach((link) => {
            link.addEventListener(
              "click",
              () => {
                mobileMenu.classList.add("hidden");

                mobileButton.setAttribute(
                  "aria-expanded",
                  "false",
                );

                mobileButton.setAttribute(
                  "aria-label",
                  "Abrir menú",
                );
              },
            );
          });
      }
    </script>
  </body>
</html>