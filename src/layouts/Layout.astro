---
import { Image } from 'astro:assets';
import { BODA_INFO } from '../data/InfoBoda.js';
import { ClientRouter } from 'astro:transitions';

import '../styles/global.css';

import letraS from '../img/s.png'; // Imagen de la letra S
import letraC from '../img/c.png'; // Imagen de la letra C


const { title } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const musicaAmbiente = `${baseUrl}mus/ambiente.mp3`;



---

<html lang="es" class="scroll-smooth">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Sergio y Carolina te invitan a celebrar su boda con una experiencia elegante y emotiva."
    />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <script
      defer
      src="https://cdn.jsdelivr.net/npm/alpinejs@3.12.0/dist/cdn.min.js"
    ></script>

    <ClientRouter />

  </head>


  <body
    class="min-h-screen bg-[var(--color-fondo)] text-[var(--color-texto)] antialiased leading-relaxed"
  >

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <header
      id="main-header"
      class="
        fixed
        top-0
        z-50
        w-full

        border-b
        border-[var(--color-borde-suave)]

        bg-[var(--color-superficie)]

        backdrop-blur-md

        transition-transform
        duration-300
        ease-in-out
      "
    >

      <div
        class="
          mx-auto
          flex
          h-20
          max-w-7xl
          items-center
          justify-between
          px-4
          sm:px-6
          lg:px-8
        "
      >

        <!-- =================================================
             LOGO
             ================================================= -->

        <a
          href="#home"
          class="
            flex
            items-center
            gap-2
            text-[var(--color-principal)]
          "
          aria-label="Inicio"
        >

          <Image
            src={BODA_INFO.anillos}
            alt="Anillo"
            class="
              h-12
              w-12
              object-contain
              sm:h-14
              sm:w-14
            "
          />


        <!-- =================================================
             BOTÓN MOBILE
             ================================================= -->

        <button
          id="mobile-menu-button"
          class="
            text-3xl
            text-[var(--color-principal)]
            lg:hidden
          "
          aria-label="Abrir menú"
          aria-expanded="false"
        >
          ☰
        </button>


        <!-- =================================================
             MENÚ DESKTOP
             ================================================= -->

        <nav class="hidden gap-8 lg:flex">

          <a
            href="#home"
            class="
              font-parrafo
              text-sm
              uppercase
              tracking-[0.15em]
              text-[var(--color-texto)]
              transition
              hover:text-[var(--color-acento)]
            "
          >
            Inicio
          </a>

          <a
            href="#story"
            class="
              font-parrafo
              text-sm
              uppercase
              tracking-[0.15em]
              text-[var(--color-texto)]
              transition
              hover:text-[var(--color-acento)]
            "
          >
            Nuestra historia
          </a>

          <a
            href="#itinerary"
            class="
              font-parrafo
              text-sm
              uppercase
              tracking-[0.15em]
              text-[var(--color-texto)]
              transition
              hover:text-[var(--color-acento)]
            "
          >
            Cronograma
          </a>

          <a
            href="#gallery"
            class="
              font-parrafo
              text-sm
              uppercase
              tracking-[0.15em]
              text-[var(--color-texto)]
              transition
              hover:text-[var(--color-acento)]
            "
          >
            Galería
          </a>

          <a
            href="/Sergio-y-Carolina/invitacion/"
            class="
              font-parrafo
              text-sm
              uppercase
              tracking-[0.15em]
              text-[var(--color-texto)]
              transition
              hover:text-[var(--color-acento)]
            "
          >
            Confirmar asistencia
          </a>

        </nav>

      </div>


      <!-- ===================================================
           MENÚ MOBILE
           =================================================== -->

      <div
        id="mobile-menu"
        class="hidden lg:hidden"
      >

        <div
          class="
            border-t
            border-[var(--color-borde-suave)]
            bg-[var(--color-superficie)]
            px-4
            py-4
            backdrop-blur-sm
          "
        >

          <div
            class="
              flex
              flex-col
              gap-2
              text-sm
              uppercase
              tracking-[0.15em]
              text-[var(--color-texto)]
            "
          >

            <a
              href="#home"
              class="
                font-parrafo
                block
                rounded-full
                px-4
                py-3
                transition
                hover:bg-[var(--color-acento-suave)]
              "
            >
              Inicio
            </a>

            <a
              href="#story"
              class="
                font-parrafo
                block
                rounded-full
                px-4
                py-3
                transition
                hover:bg-[var(--color-acento-suave)]
              "
            >
              Nuestra historia
            </a>

            <a
              href="#itinerary"
              class="
                font-parrafo
                block
                rounded-full
                px-4
                py-3
                transition
                hover:bg-[var(--color-acento-suave)]
              "
            >
              Cronograma
            </a>

            <a
              href="#gallery"
              class="
                font-parrafo
                block
                rounded-full
                px-4
                py-3
                transition
                hover:bg-[var(--color-acento-suave)]
              "
            >
              Galería
            </a>

            <a
              href="/Sergio-y-Carolina/invitacion/"
              class="
                font-parrafo
                block
                rounded-full
                px-4
                py-3
                transition
                hover:bg-[var(--color-acento-suave)]
              "
            >
              Confirmar asistencia
            </a>

          </div>

        </div>

      </div>

    </header>


    <!-- =====================================================
         CONTENIDO
         ===================================================== -->

    <main>
      <slot />
    </main>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer
      class="
        border-t
        border-[var(--color-borde-suave)]
        bg-[var(--color-superficie-media)]
        py-10
      "
    >

      <div
        class="
          section-shell
          flex
          flex-col
          items-center
          justify-between
          gap-4
          text-center
          text-sm
          text-[var(--color-texto-suave)]
          sm:flex-row
        "
      >

        <p>
          © 2026 Sergio y Carolina. Gracias por acompañarnos.
        </p>

        <p>
          Con amor, siempre.
        </p>

      </div>

    </footer>


    <!-- =====================================================
         MÚSICA
         ===================================================== -->

    <div
      x-data="{ playing: false }"
      x-init="$refs.audioEl.play().catch(() => {})"
      class="fixed bottom-5 right-5 z-50"
    >

      <audio
        x-ref="audioEl"
        src={musicaAmbiente}
        loop
        @play="playing = true"
        @pause="playing = false"
      ></audio>


      <button
        @click="
          playing
            ? $refs.audioEl.pause()
            : $refs.audioEl.play().catch(() => {})
        "
        class="
          flex
          h-11
          w-11
          items-center
          justify-center
          rounded-full
          bg-[var(--color-principal)]
          text-[var(--color-blanco)]
          shadow-lg
          transition
          hover:bg-[var(--color-principal-hover)]
        "
        :aria-label="playing ? 'Pausar música' : 'Reproducir música'"
      >

        <span
          class="text-xl"
          x-text="playing ? '⏸' : '▶'"
          aria-hidden="true"
        ></span>

      </button>

    </div>


    <!-- =====================================================
         CONTROL DEL HEADER
         ===================================================== -->

    <script>
      let lastScrollY = window.scrollY;

      const header =
        document.getElementById('main-header');

      const mobileMenu =
        document.getElementById('mobile-menu');

      const mobileButton =
        document.getElementById('mobile-menu-button');


      /* =====================================================
         OCULTAR HEADER AL BAJAR
         MOSTRAR HEADER AL SUBIR
         ===================================================== */

      function handleHeaderScroll() {

        if (!header) return;

        const currentScrollY = window.scrollY;


        /* Siempre visible arriba */

        if (currentScrollY <= 50) {

          header.classList.remove('-translate-y-full');

          lastScrollY = currentScrollY;

          return;
        }


        /* Bajando */

        if (currentScrollY > lastScrollY) {

          header.classList.add('-translate-y-full');

          /* Cerramos menú mobile si estaba abierto */

          if (mobileMenu) {
            mobileMenu.classList.add('hidden');
          }

        }

        /* Subiendo */

        else if (currentScrollY < lastScrollY) {

          header.classList.remove('-translate-y-full');

        }


        lastScrollY = currentScrollY;
      }


      window.addEventListener(
        'scroll',
        handleHeaderScroll,
        { passive: true }
      );


      /* =====================================================
         MENÚ MOBILE
         ===================================================== */

      if (mobileButton && mobileMenu) {

        mobileButton.addEventListener(
          'click',
          () => {

            const abierto =
              !mobileMenu.classList.contains('hidden');

            if (abierto) {

              mobileMenu.classList.add('hidden');

              mobileButton.setAttribute(
                'aria-expanded',
                'false'
              );

            } else {

              mobileMenu.classList.remove('hidden');

              mobileButton.setAttribute(
                'aria-expanded',
                'true'
              );

            }

          }
        );


        /* Cerrar menú al tocar un enlace */

        mobileMenu
          .querySelectorAll('a')
          .forEach((link) => {

            link.addEventListener(
              'click',
              () => {

                mobileMenu.classList.add('hidden');

                mobileButton.setAttribute(
                  'aria-expanded',
                  'false'
                );

              }
            );

          });

      }
    </script>

  </body>

</html>