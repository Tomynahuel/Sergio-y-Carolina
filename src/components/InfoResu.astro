---
import { BODA_INFO } from '../data/InfoBoda.js';
import { Image } from 'astro:assets';
---

<section class="w-full max-w-5xl mx-auto px-4 py-8">

  <div class="grid gap-6 md:grid-cols-2">


    <!-- =====================================================
         TARJETA CEREMONIA
         ===================================================== -->

    <div
      class="relative overflow-hidden
             p-8 sm:p-10
             rounded-[2rem]
             border border-[var(--color-borde)]
             shadow-sm
             transition-all duration-300
             hover:shadow-md
             bg-[var(--color-blanco)]"
    >

      <!-- Overlay -->
      <div
        class="absolute inset-0
               bg-[var(--color-overlay-suave)]
               z-0"
      ></div>


      <div class="relative z-10">


        <!-- =================================================
             HORA
             ================================================= -->

        <div
          class="font-parrafo
                 mb-5
                 inline-block
                 rounded-full
                 bg-[var(--color-bordo)]
                 px-4 py-1.5
                 text-sm
                 tracking-widest
                 text-[var(--color-blanco)]
                 shadow-sm"
        >
          {BODA_INFO.horaCeremonia}
        </div>


        <!-- =================================================
             TÍTULO
             ================================================= -->

        <h3
          class="font-subtitulo
                 text-3xl
                 text-[var(--color-texto)]
                 mb-4"
        >
          Ceremonia
        </h3>


        <!-- =================================================
             DESCRIPCIÓN
             ================================================= -->

        <p
          class="font-parrafo
                 text-[var(--color-texto-suave)]
                 leading-relaxed
                 mb-6"
        >
          Nos reuniremos a las
          {BODA_INFO.horaCeremonia}
          horas para compartir el momento más importante
          de nuestro camino.
        </p>


        <!-- =================================================
             INFORMACIÓN
             ================================================= -->

        <ul
          class="font-parrafo
                 space-y-3
                 text-[var(--color-texto-fuerte)]"
        >

          <li>
            • Comenzamos a las {BODA_INFO.horaCeremonia} h
          </li>

          <li>
            • Lugar: {BODA_INFO.lugarCeremonia}
          </li>

          <li>
            • Salón: {BODA_INFO.salonCeremonia}
          </li>

        </ul>

      </div>

    </div>



    <!-- =====================================================
         TARJETA ALMUERZO
         ===================================================== -->

    <div
      class="relative overflow-hidden
             p-8 sm:p-10
             rounded-[2rem]
             border border-[var(--color-borde)]
             shadow-sm
             transition-all duration-300
             hover:shadow-md
             bg-[var(--color-blanco)]"
    >

      <!-- Overlay -->
      <div
        class="absolute inset-0
               bg-[var(--color-overlay-suave)]
               z-0"
      ></div>


      <div class="relative z-10">


        <!-- =================================================
             HORA
             ================================================= -->

        <div
          class="font-parrafo
                 mb-5
                 inline-block
                 rounded-full
                 bg-[var(--color-bordo)]
                 px-4 py-1.5
                 text-sm
                 tracking-widest
                 text-[var(--color-blanco)]
                 shadow-sm"
        >
          {BODA_INFO.horaAlmuerzo}
        </div>


        <!-- =================================================
             TÍTULO
             ================================================= -->

        <h3
          class="font-subtitulo
                 text-3xl
                 text-[var(--color-texto)]
                 mb-4"
        >
          Almuerzo
        </h3>


        <!-- =================================================
             DESCRIPCIÓN
             ================================================= -->

        <p
          class="font-parrafo
                 text-[var(--color-texto-suave)]
                 leading-relaxed
                 mb-6"
        >
          Después de la ceremonia, habrá música, buena comida
          y un ambiente para disfrutar en familia.
        </p>


        <!-- =================================================
             INFORMACIÓN
             ================================================= -->

        <ul
          class="font-parrafo
                 space-y-3
                 text-[var(--color-texto-fuerte)]"
        >

          <li>
            • Comenzamos a las {BODA_INFO.horaAlmuerzo} h
          </li>

          <li>
            • Lugar: {BODA_INFO.lugarAlmuerzo}
          </li>

          <li>
            • Ambiente íntimo y acogedor
          </li>

        </ul>

      </div>

    </div>


  </div>

</section>