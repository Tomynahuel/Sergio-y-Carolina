---
import { Image } from "astro:assets";
import { BODA_INFO } from '../data/InfoBoda.js';

import FlorEsquina from '../img/deco-inferior-izquierda.png'; 
import decoMedio from '../img/deco-hojas1.png';
--- 

<section class="relative w-full min-h-[250px] md:min-h-[245px] flex justify-center items-center">
    
    <Image src={FlorEsquina} alt="Esquina Inf Izq" class="absolute bottom-4 left-0 md:left-4 w-40 md:w-56 h-auto object-contain mix-blend-multiply opacity-90 pointer-events-none z-0 transform -scale-y-100" />
    
    <!-- 🌸 Cambiamos el w-85 inexistente por w-80 en celulares y w-96 (o el pixelaje exacto) en PC -->
    <Image src={decoMedio} alt="Decoración Medio" class="absolute top-1/2 left-1/2 w-80 md:w-96 h-auto object-contain mix-blend-multiply opacity-90 pointer-events-none z-0 transform -translate-x-1/2 -translate-y-1/2" />
    
    <Image src={FlorEsquina} alt="Esquina Inf Der" class="absolute bottom-4 right-0 md:right-4 w-40 md:w-56 h-auto object-contain mix-blend-multiply opacity-90 pointer-events-none z-0 transform -scale-x-100 -scale-y-100" />

</section>