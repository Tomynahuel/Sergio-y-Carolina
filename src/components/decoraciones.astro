---
// src/components/Decoraciones.astro
import { Image } from 'astro:assets';

// 1. IMPORTA AQUÍ TUS NUEVAS IMÁGENES (Asegúrate de que estén en src/img/)

import fondoDecoraciones from '../img/hero2.webp'; // Fondo de la sección

import esquinaSupDerecha from '../img/esquina-superior-derecha.png'; 
import esquinaSupIzquierda from '../img/esquina-superior-izquierda.png';
import esquinaInfIzquierda from '../img/esquina-inferior-izquierda.png';
import esquinaInfDerecha from '../img/esquina-inferior-derecha.png';

//import arribaMedio from '../img/deco-arriba-medio.png';
import abajoMedio from '../img/deco-abajo-medio.png';

import bordeDerecho from '../img/deco-borde-derecha.png';
import bordeIzquierdo from '../img/deco-borde-izquierda.png';

// =====================================================================
// ⚙️ PANEL DE CONTROL DE DECORACIONES
// Ajusta aquí las posiciones exactas de cada elemento sin tocar el HTML.
// =====================================================================

const DECORACIONES = {
  fondo: {
    imagen: fondoDecoraciones,
    // Lo anclamos a la derecha en lugar de la izquierda
    posicion: "fixed top-0 right-0",
    // En celular ocupa todo el ancho (w-full), en PC solo la mitad derecha (lg:w-1/2)
    tamano: "w-full lg:w-1/2 h-screen object-cover",
    opacidad: "opacity-30",
    extra: "mix-blend-multiply" 
  },

  /* ================= ESQUINAS ================= */ 
  esquinaSuperiorDerecha: {
    imagen: esquinaSupDerecha,
    posicion: "absolute top-[45px] right-0",
    tamano: "w-40 md:w-56",
    opacidad: "opacity-40",
    extra: "mix-blend-multiply" // Borra fondos blancos
  },

  esquinaSuperiorIzquierda: {
    imagen: esquinaSupIzquierda,
    posicion: "absolute top-[45px] left-0",
    tamano: "w-48 md:w-64",
    opacidad: "opacity-50",
    extra: "mix-blend-multiply"
  },


  /* ================= LATERAL DERECHO ================= */
  // Distribución del 15% al 85% (Evitando el 10% superior y el 10% inferior)
  
  bordeDerecho1: {
    imagen: bordeDerecho,
    posicion: "absolute top-[15%] right-0 -translate-y-1/2",
    tamano: "w-24 md:w-32",
    opacidad: "opacity-50",
    extra: "mix-blend-multiply"
  },

  bordeDerecho2: {
    imagen: bordeDerecho,
    posicion: "absolute top-[35%] right-0 -translate-y-1/2",
    tamano: "w-24 md:w-32",
    opacidad: "opacity-50",
    extra: "mix-blend-multiply"
  },
  
  bordeDerecho3: {
    imagen: bordeDerecho,
    posicion: "absolute top-[55%] right-0 -translate-y-1/2",
    tamano: "w-24 md:w-32",
    opacidad: "opacity-50",
    extra: "mix-blend-multiply"
  },

 

  bordeDerecho5: {
    imagen: bordeDerecho,
    posicion: "absolute top-[85%] right-0 -translate-y-1/2",
    tamano: "w-24 md:w-32",
    opacidad: "opacity-50",
    extra: "mix-blend-multiply"
  },

  /* ================= LATERAL IZQUIERDO ================= */
  // Eliminamos transform scale-x-[-1] ya que usaremos tus propias fotos izquierdas
  
  bordeIzquierdo1: {
    imagen: bordeIzquierdo, // Asegúrate de que apunte a tu nueva foto izquierda
    posicion: "absolute top-[20%] left-0 -translate-y-1/2",
    tamano: "w-24 md:w-32",
    opacidad: "opacity-50",
    extra: "mix-blend-multiply" 
  },
  
  bordeIzquierdo2: {
    imagen: bordeIzquierdo,
    posicion: "absolute top-[45%] left-0 -translate-y-1/2",
    tamano: "w-24 md:w-32",
    opacidad: "opacity-50",
    extra: "mix-blend-multiply"
  },

  bordeIzquierdo3: {
    imagen: bordeIzquierdo,
    posicion: "absolute top-[70%] left-0 -translate-y-1/2",
    tamano: "w-24 md:w-32",
    opacidad: "opacity-50",
    extra: "mix-blend-multiply"
  },

  bordeIzquierdo4: {
    imagen: bordeIzquierdo,
    posicion: "absolute top-[90%] left-0 -translate-y-1/2",
    tamano: "w-24 md:w-32",
    opacidad: "opacity-50",
    extra: "mix-blend-multiply"
  }
  



};
---

<!-- CONTENEDOR FANTASMA: Cubre toda la sección pero no bloquea clics -->
<div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
  
  <!-- El código "lee" tu panel de control de arriba y dibuja las fotos automáticamente -->
  {Object.entries(DECORACIONES).map(([nombre, deco]) => (
    <Image 
      src={deco.imagen} 
      alt={`Decoración ${nombre}`} 
      class={`${deco.posicion} ${deco.tamano} ${deco.opacidad} ${deco.extra}`} 
    />
  ))}

</div>