---
import { Image } from "astro:assets";
import teEsperamos from '../img/deco-teEsperamos.png'; 
--- 
<section class="relative w-full py-12 md:py-16 flex flex-col justify-center items-center overflow-hidden gap-6">
    
    <h2 class="text-6xl md:text-8xl text-botanical font-serif z-10">Te esperamos.</h2>

    <Image 
      src={teEsperamos} 
      alt="¡Te esperamos!" 
      class="w-full max-w-5xl h-auto object-contain mix-blend-multiply opacity-95 z-10 relative" 
    />

</section>