---
import { Image } from "astro:assets";

// Asegúrate de usar la extensión correcta (.png o .jpg) según tu archivo real
import teEsperamos from '../img/deco-teEsperamos.png'; 
--- 

<!-- Agregamos flex-col y un pequeño gap para separar el texto de la imagen -->
<section class="relative w-full py-12 md:py-16 flex flex-col justify-center items-center overflow-hidden gap-6">
    
    <!-- Texto en cursiva y grande -->
    <h2 
      class="text-6xl md:text-8xl text-botanical font-serif z-10" 
      
    >
      Te esperamos
    </h2>

    <!-- 
      mix-blend-multiply: Elimina el fondo blanco de la imagen fusionándolo con el color de tu página.
      object-contain y h-auto: Evita que la imagen se mutile o recorte en celulares.
    -->
    <Image 
      src={teEsperamos} 
      alt="¡Te esperamos!" 
      class="w-full max-w-5xl h-auto object-contain mix-blend-multiply opacity-95 z-10 relative" 
    />

</section>