---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;
---

<div class="max-w-md w-full bg-white rounded-3xl shadow-2xl border border-mist/50 text-center relative overflow-hidden min-h-[420px]">

  <div class="relative w-full h-full flex items-center min-h-[350px]">
    
    <div id="paso-1" class="w-full p-10 absolute inset-0 flex flex-col justify-center transition-transform duration-500 transform translate-x-0">
      <h1 class="text-4xl md:text-5xl mb-4 text-botanical">¡Bienvenidos!</h1>
      <p class="text-lg mb-8 font-sans text-botanical/80">Qué alegría inmensa compartir este momento tan especial con vos. Estamos preparando una noche inolvidable.</p>
      
      <button onclick="mostrarPaso(2)" class="bg-botanical text-ivory px-8 py-3 rounded-full uppercase tracking-widest text-sm hover:bg-opacity-90 hover:shadow-lg transition-all w-full font-sans mt-auto">
        Siguiente
      </button>
    </div>

    <div id="paso-2" class="w-full p-10 absolute inset-0 flex flex-col justify-center transition-transform duration-500 transform translate-x-full">
      <h2 class="text-3xl mb-4 text-botanical">Anotá la fecha</h2>
      <p class="text-lg mb-8 font-sans text-botanical/80">El gran día será el <strong>3 de Octubre de 2026</strong>. Preparate para celebrar el amor, la familia y la amistad por todo lo alto.</p>
      
      <button onclick="mostrarPaso(3)" class="bg-botanical text-ivory px-8 py-3 rounded-full uppercase tracking-widest text-sm hover:bg-opacity-90 hover:shadow-lg transition-all w-full font-sans mt-auto">
        Siguiente
      </button>
    </div>

    <div id="paso-3" class="w-full p-10 absolute inset-0 flex flex-col justify-center transition-transform duration-500 transform translate-x-full">
      <h2 class="text-3xl mb-4 text-botanical">Pequeños Detalles</h2>
      <p class="text-lg mb-8 font-sans text-botanical/80">Queremos que te relajes y disfrutes al máximo. El código de vestimenta es elegante, ¡pero lo más importante es que vengas con ganas de bailar!</p>
      
      <button onclick="mostrarPaso(4)" class="bg-botanical text-ivory px-8 py-3 rounded-full uppercase tracking-widest text-sm hover:bg-opacity-90 hover:shadow-lg transition-all w-full font-sans mt-auto">
        Siguiente
      </button>
    </div>

    <div id="paso-4" class="w-full p-10 absolute inset-0 flex flex-col justify-center transition-transform duration-500 transform translate-x-full">
      <h2 class="text-3xl mb-4 text-botanical">Tu Invitación</h2>
      <p class="text-md mb-6 font-sans text-botanical/80">Por favor, ingresá tu nombre y apellido para acceder y confirmar tu asistencia.</p>
      
      <input 
        type="text" 
        id="nombreIngresado"
        placeholder="Ej: Juan Perez" 
        class="w-full border-b-2 border-botanical/50 bg-transparent text-center text-xl py-2 mb-6 focus:outline-none focus:border-botanical transition-colors placeholder:text-botanical/30 font-sans"
      >
      
      <button 
        id="btnIngresar"
        class="bg-botanical text-ivory px-8 py-3 rounded-full uppercase tracking-widest text-sm hover:bg-opacity-90 hover:shadow-lg transition-all w-full font-sans mt-auto">
        Verificar
      </button>
      <p id="mensajeError" class="text-rose-600 mt-4 text-sm font-sans font-medium hidden"></p>
    </div>

    <div id="paso-5" class="w-full p-10 absolute inset-0 flex flex-col justify-center transition-transform duration-500 transform translate-x-full">
      <h2 class="text-3xl mb-4 text-botanical">¡Qué alegría que vengas!</h2>
      <p class="text-md mb-4 font-sans text-botanical/80">Para terminar de confirmar tu lugar, te pedimos que abones el valor de la tarjeta.</p>
      
      <div class="bg-mist/30 p-4 rounded-xl border border-botanical/20 mb-6 text-sm text-botanical text-left font-sans">
        <p class="mb-1"><strong>Alias:</strong> boda.sergio.caro</p>
        <p class="mb-1"><strong>CBU:</strong> 0000000000000000000000</p>
        <p class="mt-3">Enviá el comprobante por WhatsApp al:<br><strong class="text-base">+54 9 11 1234-5678</strong></p>
      </div>

      <button 
        onclick="irAInvitacion()"
        class="bg-botanical text-ivory px-8 py-3 rounded-full uppercase tracking-widest text-sm hover:bg-opacity-90 hover:shadow-lg transition-all w-full font-sans mt-auto">
        Ver la Invitación
      </button>
    </div>

  </div>
</div>

<script define:vars={{ baseUrl }}>
  const listaInvitados = [
    { nombre: 'juan perez', paga: true },
    { nombre: 'carolina ramirez', paga: false },
    { nombre: 'familia gomez', paga: true },
    { nombre: 'sergio martinez', paga: false }
  ];

  // El Motor del Deslizamiento
  window.mostrarPaso = function(numeroPaso) {
    for (let i = 1; i <= 5; i++) {
      const pasoDiv = document.getElementById('paso-' + i);
      if (!pasoDiv) continue;
      
      if (i < numeroPaso) {
        // Los pasos anteriores se deslizan hacia la izquierda (-100%)
        pasoDiv.classList.remove('translate-x-0', 'translate-x-full');
        pasoDiv.classList.add('-translate-x-full');
      } else if (i === numeroPaso) {
        // El paso actual entra y se centra (0)
        pasoDiv.classList.remove('translate-x-full', '-translate-x-full');
        pasoDiv.classList.add('translate-x-0');
      } else {
        // Los pasos futuros esperan escondidos a la derecha (100%)
        pasoDiv.classList.remove('translate-x-0', '-translate-x-full');
        pasoDiv.classList.add('translate-x-full');
      }
    }
  }

  window.irAInvitacion = function() {
    window.location.href = baseUrl + 'invitacion';
  }

  const input = document.getElementById('nombreIngresado');
  const btn = document.getElementById('btnIngresar');
  const error = document.getElementById('mensajeError');

  function verificar() {
    const nombreLimpio = input.value
      .trim()
      .toLowerCase()
      .normalize("NFD").replace(/[\u0300-\u036f]/g, "");

    if (nombreLimpio === '') {
      error.textContent = 'Por favor, ingresá un nombre.';
      error.classList.remove('hidden');
      return;
    }

    const invitado = listaInvitados.find(persona => persona.nombre === nombreLimpio);

    if (invitado) {
      error.classList.add('hidden');
      if (invitado.paga) {
        window.mostrarPaso(5); // Si paga, el panel de pago se desliza
      } else {
        window.irAInvitacion(); // Si no paga, redirige directamente
      }
    } else {
      error.textContent = 'No encontramos tu nombre. Por favor, intentá escribiendo solo nombre y apellido.';
      error.classList.remove('hidden');
    }
  }

  btn.addEventListener('click', verificar);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') verificar();
  });
</script>