---
import { Image } from 'astro:assets';
import heroImage from '../img/hero.jpg';
import { BODA_INFO } from '../data/InfoBoda.js';
---

<section id="contact" class="w-full max-w-xl mx-auto">
  <div class="soft-card p-6 sm:p-10 w-full">
    
    <div class="mb-8 text-center">
      <p class="text-xs uppercase tracking-[0.3em] text-botanical font-bold">Contacto</p>
      <h2 class="mt-2 font-serif text-3xl sm:text-4xl text-botanical">Nuestro equipo</h2>
    </div>

    <div class="flex flex-col gap-6 w-full">
      
      <div class="flex flex-col sm:flex-row items-center gap-5 sm:gap-6 p-5 sm:p-6 bg-[#FAFAFA] rounded-2xl border border-gray-100 shadow-sm transition-all duration-300 hover:bg-white hover:shadow-md text-center sm:text-left w-full">
        <div class="h-24 w-24 sm:h-28 sm:w-28 shrink-0 overflow-hidden rounded-full border border-gray-200 shadow-sm">
          <Image src={heroImage} alt={BODA_INFO.contacto1} class="h-full w-full object-cover" />
        </div>
        
        <div class="flex-1 min-w-0 w-full">
          <h3 class="text-xl font-semibold text-botanical leading-snug">{BODA_INFO.contacto1}</h3>
          <p class="text-xs font-bold uppercase tracking-wider text-gray-500 mt-1">Organizador</p>
          <p class="mt-3 text-sm text-gray-600 break-all sm:break-words">{BODA_INFO.emailContacto1}</p>
          <p class="text-sm text-gray-600 mt-0.5">{BODA_INFO.numeroTelefono1}</p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-5 sm:gap-6 p-5 sm:p-6 bg-[#FAFAFA] rounded-2xl border border-gray-100 shadow-sm transition-all duration-300 hover:bg-white hover:shadow-md text-center sm:text-left w-full">
        <div class="h-24 w-24 sm:h-28 sm:w-28 shrink-0 overflow-hidden rounded-full border border-gray-200 shadow-sm">
          <Image src={heroImage} alt={BODA_INFO.contacto2} class="h-full w-full object-cover" />
        </div>
        
        <div class="flex-1 min-w-0 w-full">
          <h3 class="text-xl font-semibold text-botanical leading-snug">{BODA_INFO.contacto2}</h3>
          <p class="text-xs font-bold uppercase tracking-wider text-gray-500 mt-1">Organizadora</p>
          <p class="mt-3 text-sm text-gray-600 break-all sm:break-words">{BODA_INFO.emailContacto2}</p>
          <p class="text-sm text-gray-600 mt-0.5">{BODA_INFO.numeroTelefono2}</p>
        </div>
      </div>

    </div>
  </div>
</section>