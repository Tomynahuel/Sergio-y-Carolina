---
import { BODA_INFO } from '../data/InfoBoda.js';
import { Image } from 'astro:assets';
import marmolBg from '../img/marmol.png';
---

<section id="contact" class="w-full max-w-xl mx-auto">
  <div class="relative overflow-hidden p-6 sm:p-10 w-full rounded-[2rem] border border-[#c5a880] shadow-sm bg-white">
    
    <!-- Mármol Nativo y Capa Protectora -->
    <div class="absolute inset-0 z-0 opacity-100 overflow-hidden">
      <Image 
        src={marmolBg} 
        alt="Fondo Mármol" 
        class="w-full h-full object-cover object-center" 
      />
    </div>
    <div class="absolute inset-0 bg-white/50 z-0"></div>

    <div class="relative z-10">
      <div class="mb-8 text-center">
        <!-- Etiqueta sutil en Bordó -->
        <p class="text-xs uppercase tracking-[0.3em] text-[#5c101d] font-bold">Contacto</p>
        <h2 class="mt-2 font-serif text-3xl sm:text-4xl text-[#c5a880]">Nuestro equipo</h2>
      </div>

      <div class="flex flex-col gap-6 w-full">
        
        <!-- Tarjeta Contacto 1 -->
        <div class="flex flex-col sm:flex-row items-center gap-5 sm:gap-6 p-5 sm:p-6 bg-white/70 backdrop-blur-sm rounded-2xl border border-[#c5a880]/30 shadow-sm transition-all duration-300 hover:bg-white hover:shadow-md text-center sm:text-left w-full">
          <div class="flex-1 min-w-0 w-full">
            <h3 class="text-xl font-serif font-semibold text-[#c5a880] leading-snug">{BODA_INFO.contacto1}</h3>
            <p class="text-xs font-bold uppercase tracking-wider text-[#5c101d] mt-1">Organizador</p>
            <p class="mt-3 text-sm text-gray-800 font-medium break-all sm:break-words">{BODA_INFO.emailContacto1}</p>
            <p class="text-sm text-gray-800 font-medium mt-0.5">{BODA_INFO.numeroTelefono1}</p>
          </div>
        </div>

        <!-- Tarjeta Contacto 2 -->
        <div class="flex flex-col sm:flex-row items-center gap-5 sm:gap-6 p-5 sm:p-6 bg-white/70 backdrop-blur-sm rounded-2xl border border-[#c5a880]/30 shadow-sm transition-all duration-300 hover:bg-white hover:shadow-md text-center sm:text-left w-full">
          <div class="flex-1 min-w-0 w-full">
            <h3 class="text-xl font-serif font-semibold text-[#c5a880] leading-snug">{BODA_INFO.contacto2}</h3>
            <p class="text-xs font-bold uppercase tracking-wider text-[#5c101d] mt-1">Organizadora</p>
            <p class="mt-3 text-sm text-gray-800 font-medium break-all sm:break-words">{BODA_INFO.emailContacto2}</p>
            <p class="text-sm text-gray-800 font-medium mt-0.5">{BODA_INFO.numeroTelefono2}</p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>