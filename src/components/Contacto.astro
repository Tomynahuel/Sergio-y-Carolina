---
import { BODA_INFO } from "../data/InfoBoda.js";

const mensajeWhatsApp = encodeURIComponent(
  "¡Hola! Tengo una consulta sobre la boda.",
);

const numeroContacto1 = BODA_INFO.numeroTelefono1.replace(/\D/g, "");
const numeroContacto2 = BODA_INFO.numeroTelefono2.replace(/\D/g, "");

const linkContacto1 = `https://wa.me/${numeroContacto1}?text=${mensajeWhatsApp}`;
const linkContacto2 = `https://wa.me/${numeroContacto2}?text=${mensajeWhatsApp}`;
---

<section id="contact" class="section-shell py-10">
  <div class="w-full">
    <!-- =================================================
         ENCABEZADO
         ================================================= -->

    <div class="mb-8 text-center">
      <p
        class="font-destacado text-xs uppercase tracking-[0.3em] text-[var(--color-verde)]"
      >
        Contacto
      </p>

      <h2
        class="font-titulo mt-2 text-3xl text-[var(--color-titulos)] sm:text-4xl"
      >
        ¿Necesitas ayuda?
      </h2>
    </div>

    <!-- =================================================
         CONTACTOS
         ================================================= -->

    <div class="flex w-full flex-col gap-6">
      <!-- =================================================
           CONTACTO 1
           ================================================= -->

      <a
        href={linkContacto1}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Contactar por WhatsApp a ${BODA_INFO.contacto1}`}
        class="group block w-full"
      >
        <div
          class="flex w-full flex-col items-center gap-5 rounded-2xl border border-[var(--color-borde-suave)] bg-[var(--color-superficie-blanda)] p-5 text-center shadow-sm backdrop-blur-sm transition-all duration-300 hover:bg-[var(--color-superficie)] hover:shadow-md sm:flex-row sm:gap-6 sm:p-6 sm:text-left"
        >
          <div class="w-full min-w-0 flex-1">
            <h3
              class="font-subtitulo text-xl leading-snug text-[var(--color-negro)]"
            >
              {BODA_INFO.contacto1}
            </h3>

            <p
              class="font-palabra mt-1 text-xs uppercase tracking-wider text-[var(--color-verde)]"
            >
              Organizador
            </p>


            <p
              class="font-parrafo mt-3 text-xs text-[var(--color-verde)] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
            >
              Toca para contactar por WhatsApp
            </p>
          </div>
        </div>
      </a>

      <!-- =================================================
           CONTACTO 2
           ================================================= -->

      <a
        href={linkContacto2}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Contactar por WhatsApp a ${BODA_INFO.contacto2}`}
        class="group block w-full"
      >
        <div
          class="flex w-full flex-col items-center gap-5 rounded-2xl border border-[var(--color-borde-suave)] bg-[var(--color-superficie-blanda)] p-5 text-center shadow-sm backdrop-blur-sm transition-all duration-300 hover:bg-[var(--color-superficie)] hover:shadow-md sm:flex-row sm:gap-6 sm:p-6 sm:text-left"
        >
          <div class="w-full min-w-0 flex-1">
            <h3
              class="font-subtitulo text-xl leading-snug text-[var(--color-negro)]"
            >
              {BODA_INFO.contacto2}
            </h3>

            <p
              class="font-palabra mt-1 text-xs uppercase tracking-wider text-[var(--color-verde)]"
            >
              Organizadora
            </p>


            <p
              class="font-parrafo mt-3 text-xs text-[var(--color-verde)] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
            >
              Toca para contactar por WhatsApp
            </p>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>