---
import { BODA_INFO } from '../data/InfoBoda.js';
import { Image } from 'astro:assets';
---

<section id="contact" class="w-full max-w-xl mx-auto">

  <div
    class="soft-card relative overflow-hidden
           p-6 sm:p-10
           w-full
           rounded-[2rem]
           border border-[var(--color-borde)]
           box-shadow"
  >

    <!-- Capa protectora -->
    <div
      class="absolute inset-0
             bg-[var(--color-overlay-suave)]
             z-0"
    ></div>


    <div class="relative z-10">

      <!-- =================================================
           ENCABEZADO
           ================================================= -->

      <div class="mb-8 text-center">

        <!-- Etiqueta -->
        <p
          class="font-destacado
                 text-xs
                 uppercase
                 tracking-[0.3em]
                 text-[var(--color-verde)]"
        >
          Contacto
        </p>


        <!-- Título -->
        <h2
          class="font-titulo
                 mt-2
                 text-3xl sm:text-4xl
                 text-[var(--color-titulos)]"
        >
          Nuestro equipo
        </h2>

      </div>


      <!-- =================================================
           CONTACTOS
           ================================================= -->

      <div class="flex flex-col gap-6 w-full">


        <!-- =================================================
             CONTACTO 1
             ================================================= -->

        <div
          class="flex flex-col sm:flex-row
                 items-center
                 gap-5 sm:gap-6
                 p-5 sm:p-6
                 bg-[var(--color-superficie-blanda)]
                 backdrop-blur-sm
                 rounded-2xl
                 border border-[var(--color-borde-suave)]
                 shadow-sm
                 transition-all duration-300
                 hover:bg-[var(--color-superficie)]
                 hover:shadow-md
                 text-center sm:text-left
                 w-full"
        >

          <div class="flex-1 min-w-0 w-full">

            <!-- Nombre -->
            <h3
              class="font-subtitulo
                     text-xl
                     text-[var(--color-negro)]
                     leading-snug"
            >
              {BODA_INFO.contacto1}
            </h3>


            <!-- Rol -->
            <p
              class="font-palabra
                     text-xs
                     uppercase
                     tracking-wider
                     text-[var(--color-verde)]
                     mt-1"
            >
              Organizador
            </p>


            <!-- Teléfono -->
            <p
              class="font-parrafo
                     text-sm
                     text-[var(--color-texto)]
                     mt-0.5"
            >
              {BODA_INFO.numeroTelefono1}
            </p>

          </div>

        </div>


        <!-- =================================================
             CONTACTO 2
             ================================================= -->

        <div
          class="flex flex-col sm:flex-row
                 items-center
                 gap-5 sm:gap-6
                 p-5 sm:p-6
                 bg-[var(--color-superficie-blanda)]
                 backdrop-blur-sm
                 rounded-2xl
                 border border-[var(--color-borde-suave)]
                 shadow-sm
                 transition-all duration-300
                 hover:bg-[var(--color-superficie)]
                 hover:shadow-md
                 text-center sm:text-left
                 w-full"
        >

          <div class="flex-1 min-w-0 w-full">

            <!-- Nombre -->
            <h3
              class="font-subtitulo
                     text-xl
                     text-[var(--color-negro)]
                     leading-snug"
            >
              {BODA_INFO.contacto2}
            </h3>


            <!-- Rol -->
            <p
              class="font-palabra
                     text-xs
                     uppercase
                     tracking-wider
                     text-[var(--color-verde)]
                     mt-1"
            >
              Organizadora
            </p>


            <!-- Teléfono -->
            <p
              class="font-parrafo
                     text-sm
                     text-[var(--color-texto)]
                     mt-0.5"
            >
              {BODA_INFO.numeroTelefono2}
            </p>

          </div>

        </div>


      </div>

    </div>

  </div>

</section>