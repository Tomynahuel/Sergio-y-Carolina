---
// 1. Calculamos la ruta base leyendo tu astro.config.mjs
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// 2. Unimos el base con el nombre de tu página
const rutaInvitacion = `${baseUrl}invitacion`;
---

<section id="pre-invitation" class="section-shell py-12">
  <div
    class="flex flex-col items-center justify-center rounded-[36px] bg-white p-10 text-center shadow-xl transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl"
  >
    <div class="mb-6 h-16 w-16 text-[#d4af37]">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="h-full w-full"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
        ></path>
      </svg>
    </div>

    <h2 class="mb-4 font-serif text-4xl text-botanical">
      Confirma tu asistencia
    </h2>

    <p class="mb-8 max-w-sm text-gray-600">
      Nos encantaría que seas parte de este momento tan especial. Por favor,
      haznos saber si podrás acompañarnos.
    </p>

    <a
      href={rutaInvitacion}
      class="inline-block rounded-full bg-botanical px-8 py-4 text-sm font-semibold uppercase tracking-wider text-ivory shadow-md transition-all duration-300 hover:bg-sage hover:shadow-lg"
    >
      Ir a la Confirmación
    </a>
  </div>
</section>
