---
import { BODA_INFO } from "../data/InfoBoda.js";
---

<div id="confirma-asistencia" class="section-shell py-10">
  <div
    class="relative overflow-hidden rounded-[2rem] border border-[var(--color-borde)] bg-[var(--color-blanco)] p-6 text-center shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md sm:p-10"
  >
    <!-- Capa de overlay -->
    <div class="absolute inset-0 z-0 bg-[var(--color-overlay-suave)]"></div>

    <!-- Contenido -->
    <div class="relative z-10">
      <!-- TÍTULO -->
      <h2
        class="font-titulo mt-3 text-4xl text-[var(--color-bordo-rosa)] sm:text-5xl"
      >
        Confirma tu asistencia
      </h2>

      <!-- PÁRRAFO PRINCIPAL -->
      <p
        class="font-parrafo mx-auto mt-4 max-w-2xl text-lg text-[var(--color-texto-suave)]"
      >
        Tu presencia hará que este día sea aún más especial. Nos encantaría
        compartirlo contigo.
      </p>

      <!-- DETALLE FECHA LÍMITE -->
      <div
        class="mx-auto mt-8 max-w-md rounded-2xl border border-[var(--color-borde)] bg-[var(--color-superficie-blanda)] p-6 text-[var(--color-texto)] shadow-sm backdrop-blur-sm"
      >
        <!-- DESTACADO -->
        <p
          class="font-destacado text-lg uppercase tracking-widest text-[var(--color-bordo)]"
        >
          Fecha límite
        </p>

        <!-- PÁRRAFO INTERNO -->
        <p class="font-parrafo mt-2">
          Por favor responde antes del
          {BODA_INFO.fechaLimite}
          de
          {BODA_INFO.mesLimite}.
        </p>
      </div>
    </div>
  </div>
</div>
