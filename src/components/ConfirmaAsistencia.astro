---
import { BODA_INFO } from '../data/InfoBoda.js';
import { Image } from 'astro:assets';
import marmolBg from '../img/marmol.png';
---

<div id="confirma-asistencia" class="pb-10 sm:pb-20 px-4 sm:px-8 w-full max-w-5xl mx-auto">
  <div class="relative overflow-hidden p-6 sm:p-10 rounded-[2rem] border border-[#c5a880] shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md bg-white text-center">
    
    <!-- Mármol Nativo y Capa Protectora -->
    <div class="absolute inset-0 z-0 opacity-100 overflow-hidden">
      <Image 
        src={marmolBg} 
        alt="Fondo Mármol" 
        class="w-full h-full object-cover object-center" 
      />
    </div>
    <div class="absolute inset-0 bg-white/50 z-0"></div>

    <div class="relative z-10">
      <h2 class="mt-3 font-serif text-4xl sm:text-5xl text-[#c5a880]">Confirma tu asistencia</h2>
      <p class="mt-4 text-lg text-gray-800 font-medium max-w-2xl mx-auto">Tu presencia hará que este día sea aún más especial. Nos encantaría compartirlo contigo.</p>
      
      <!-- Detalle Fecha Límite elegante -->
      <div class="mt-8 mx-auto max-w-md rounded-2xl bg-white/70 backdrop-blur-sm p-6 text-gray-800 border border-[#c5a880]/30 shadow-sm">
        <p class="font-bold text-[#5c101d] text-lg uppercase tracking-widest">Fecha límite</p>
        <p class="mt-2 font-medium">Por favor responde antes del {BODA_INFO.fechaLimite} de {BODA_INFO.mesLimite}.</p>
      </div>
    </div>
  </div>
</div>