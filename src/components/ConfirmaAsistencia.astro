---
import { BODA_INFO } from '../data/InfoBoda.js';
import { Image } from 'astro:assets';
---

<div
  id="confirma-asistencia"
  class="sm:pb-2 px-4 sm:px-2 w-full max-w-5xl mx-auto"
>

  <div
    class="relative overflow-hidden
           p-6 sm:p-10
           rounded-[2rem]
           border border-[var(--color-borde)]
           shadow-sm
           transition duration-300
           hover:-translate-y-1
           hover:shadow-md
           bg-[var(--color-blanco)]
           text-center"
  >

    <!-- Capa de overlay -->
    <div
      class="absolute inset-0
             bg-[var(--color-overlay-suave)]
             z-0"
    ></div>


    <!-- Contenido -->
    <div class="relative z-10">

      <!-- TÍTULO -->
      <h2
        class="font-titulo
               mt-3
               text-4xl sm:text-5xl
               text-[var(--color-bordo-rosa)]"
      >
        Confirma tu asistencia
      </h2>


      <!-- PÁRRAFO PRINCIPAL -->
      <p
        class="font-parrafo
               mt-4
               text-lg
               text-[var(--color-texto-suave)]
               max-w-2xl
               mx-auto"
      >
        Tu presencia hará que este día sea aún más especial.
        Nos encantaría compartirlo contigo.
      </p>


      <!-- DETALLE FECHA LÍMITE -->
      <div
        class="mt-8
               mx-auto
               max-w-md
               rounded-2xl
               bg-[var(--color-superficie-blanda)]
               backdrop-blur-sm
               p-6
               text-[var(--color-texto)]
               border border-[var(--color-borde)]
               shadow-sm"
      >

        <!-- DESTACADO -->
        <p
          class="font-destacado
                 text-[var(--color-bordo)]
                 text-lg
                 uppercase
                 tracking-widest"
        >
          Fecha límite
        </p>


        <!-- PÁRRAFO INTERNO -->
        <p
          class="font-parrafo
                 mt-2"
        >
          Por favor responde antes del
          {BODA_INFO.fechaLimite}
          de
          {BODA_INFO.mesLimite}.
        </p>

      </div>

    </div>

  </div>

</div>