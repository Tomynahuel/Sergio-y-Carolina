---
import { BODA_INFO } from '../data/InfoBoda.js';
import { Image } from 'astro:assets';
---

<div id="confirma-asistencia" class=" sm:pb-2 px-4 sm:px-2 w-full max-w-5xl mx-auto">
  <div class="relative overflow-hidden p-6 sm:p-10 rounded-[2rem] border border-[var(--color-borde)] shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md bg-[var(--color-blanco)] text-center">
    
    <div class="absolute inset-0 bg-[var(--color-overlay-suave)] z-0"></div>
    <div class="relative z-10">
      <h2 class="mt-3 font-serif text-4xl sm:text-5xl text-[var(--color-bordo-rosa)]">
        Confirma tu asistencia
      </h2>

      <p class="mt-4 text-lg text-[var(--color-texto-suave)] font-medium max-w-2xl mx-auto">
        Tu presencia hará que este día sea aún más especial. Nos encantaría compartirlo contigo.
      </p>
      
      <!-- Detalle Fecha Límite elegante -->
      <div class="mt-8 mx-auto max-w-md rounded-2xl bg-[var(--color-superficie-blanda)] backdrop-blur-sm p-6 text-[var(--color-texto)] border border-[var(--color-borde)] shadow-sm">
        
        <p class="font-bold text-[var(--color-bordo)] text-lg uppercase tracking-widest">
          Fecha límite
        </p>

        <p class="mt-2 font-medium">
          Por favor responde antes del {BODA_INFO.fechaLimite} de {BODA_INFO.mesLimite}.
        </p>

      </div>
    </div>
  </div>
</div>