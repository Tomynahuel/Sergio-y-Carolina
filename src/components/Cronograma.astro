---
import { BODA_INFO } from "../data/InfoBoda.js";
---

<section id="itinerary" class="py-10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-10xl soft-card mx-auto p-8 sm:p-12">
      <!-- =====================================================
           ENCABEZADO
           ===================================================== -->

      <div class="mb-12 text-center">
        <h2 class="font-titulo text-4xl text-[var(--color-verde)] sm:text-5xl">
          Cronograma
        </h2>
      </div>

      <!-- =====================================================
           CONTENEDOR DE EVENTOS
           ===================================================== -->

      <div
        class="mx-auto grid max-w-4xl grid-cols-1 items-stretch gap-6 text-center sm:gap-8 md:grid-cols-2"
      >
        <!-- ===================================================
             TARJETA CEREMONIA
             =================================================== -->

        <div
          class="softcard-interno relative flex h-full cursor-pointer flex-col items-center overflow-hidden rounded-3xl p-8 shadow-sm transition-all duration-300 hover:scale-[1.03] hover:shadow-xl"
        >
          <div class="relative z-10 flex h-full w-full flex-col items-center">
            <!-- TÍTULO -->
            <h3
              class="font-subtitulo mb-6 text-5xl text-[var(--color-titulos)]"
            >
              Ceremonia
            </h3>

            <!-- =================================================
                 FECHA Y HORA
                 ================================================= -->

            <div
              class="mb-6 flex w-full items-center justify-center gap-6 border-b border-[var(--color-borde-suave)] pb-4"
            >
              <!-- FECHA -->

              <div class="text-center">
                <p class="font-palabra text-3xl text-[var(--color-texto)]">
                  {BODA_INFO.fechaCeremonia}
                </p>

                <p
                  class="font-destacado mt-1 text-[9px] uppercase tracking-widest text-[var(--color-verde-claro)]"
                >
                  {BODA_INFO.mesCeremonia}
                </p>
              </div>

              <!-- SEPARADOR -->

              <div class="h-10 w-px bg-[var(--color-verde-claro)]"></div>

              <!-- HORA -->

              <div class="text-center">
                <p class="font-palabra text-3xl text-[var(--color-texto)]">
                  {BODA_INFO.horaCeremonia}
                </p>

                <p
                  class="font-destacado mt-1 text-[9px] uppercase tracking-widest text-[var(--color-verde-claro)]"
                >
                  Horas
                </p>
              </div>
            </div>

            <!-- =================================================
                 UBICACIÓN
                 ================================================= -->

            <div class="mb-8 w-full flex-grow">
              <!-- Lugar -->
              <p class="font-destacado mb-2 text-[var(--color-texto)]">
                {BODA_INFO.salonCeremonia}
              </p>

              <!-- Dirección -->
              <p class="font-parrafo text-sm text-[var(--color-texto-suave)]">
                {BODA_INFO.lugarCeremonia}
              </p>
            </div>
          </div>
        </div>

        <!-- ===================================================
             TARJETA ALMUERZO
             =================================================== -->

        <div
          class="softcard-interno relative flex h-full cursor-pointer flex-col items-center overflow-hidden rounded-3xl p-8 shadow-sm transition-all duration-300 hover:scale-[1.03] hover:shadow-xl"
        >
          <div class="relative z-10 flex h-full w-full flex-col items-center">
            <!-- TÍTULO -->
            <h3
              class="font-subtitulo mb-6 text-5xl text-[var(--color-titulos)]"
            >
              Almuerzo
            </h3>

            <!-- =================================================
                 FECHA Y HORA
                 ================================================= -->

            <div
              class="mb-6 flex w-full items-center justify-center gap-6 border-b border-[var(--color-borde-suave)] pb-4"
            >
              <!-- FECHA -->

              <div class="text-center">
                <p class="font-palabra text-3xl text-[var(--color-texto)]">
                  {BODA_INFO.fechaAlmuerzo}
                </p>

                <p
                  class="font-destacado mt-1 text-[9px] uppercase tracking-widest text-[var(--color-verde-claro)]"
                >
                  {BODA_INFO.mesAlmuerzo}
                </p>
              </div>

              <!-- SEPARADOR -->

              <div class="h-10 w-px bg-[var(--color-verde-claro)]"></div>

              <!-- HORA -->

              <div class="text-center">
                <p class="font-palabra text-3xl text-[var(--color-texto)]">
                  {BODA_INFO.horaAlmuerzo}
                </p>

                <p
                  class="font-destacado mt-1 text-[9px] uppercase tracking-widest text-[var(--color-verde-claro)]"
                >
                  Horas
                </p>
              </div>
            </div>

            <!-- =================================================
                 UBICACIÓN
                 ================================================= -->

            <div class="mb-8 w-full flex-grow">
              <!-- Lugar -->
              <p class="font-destacado mb-2 text-[var(--color-texto)]">
                {BODA_INFO.lugarAlmuerzo}
              </p>

              <!-- Dirección -->
              <p class="font-parrafo text-sm text-[var(--color-texto-suave)]">
                {BODA_INFO.direccionAlmuerzo}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
