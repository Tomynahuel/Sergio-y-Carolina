---
import { BODA_INFO } from '../data/InfoBoda.js';

---

<section id="itinerary" class="py-10 bg-ivory">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  
    <div class="max-w-10xl soft-card mx-auto p-8 sm:p-12 ">
      
      <div class="text-center mb-12">
        <h2 class="font-serif text-4xl text-botanical sm:text-5xl">Cronograma</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 text-center items-stretch max-w-4xl mx-auto">

        <div class="flex flex-col items-center h-full p-8 bg-white rounded-3xl shadow-sm transition-all duration-300 hover:scale-[1.03] hover:shadow-xl cursor-pointer">
          
          <h3 class="font-serif text-5xl text-botanical mb-6" style="font-family: 'Great Vibes', serif;">Ceremonia</h3>
          
          <div class="flex items-center justify-center gap-6 w-full border-b border-gray-200 pb-4 mb-6">
            <div class="text-center">
              <p class="text-3xl text-gray-600 font-light">{BODA_INFO.fechaCeremonia}</p>
              <p class="text-[9px] tracking-widest text-gray-400 uppercase mt-1">{BODA_INFO.mesCeremonia}</p>
            </div>
            <div class="w-px h-10 bg-gray-300"></div>
            <div class="text-center">
              <p class="text-3xl text-gray-600 font-light">{BODA_INFO.horaCeremonia}</p>
              <p class="text-[9px] tracking-widest text-gray-400 uppercase mt-1">Horas</p>
            </div>
          </div>

          <div class="flex-grow mb-8 w-full">
            <p class="font-bold text-gray-600 mb-2">{BODA_INFO.salonCeremonia}</p>
            <p class="text-sm text-gray-500">{BODA_INFO.lugarCeremonia}</p>
          </div>
        </div>

        <div class="flex flex-col items-center h-full p-8 bg-white rounded-3xl shadow-sm transition-all duration-300 hover:scale-[1.03] hover:shadow-xl cursor-pointer">
          
          <h3 class="font-serif text-5xl text-botanical mb-6" style="font-family: 'Great Vibes', serif;">Almuerzo</h3>
          
          <div class="flex items-center justify-center gap-6 w-full border-b border-gray-200 pb-4 mb-6">
            <div class="text-center">
              <p class="text-3xl text-gray-600 font-light">{BODA_INFO.fechaAlmuerzo}</p>
              <p class="text-[9px] tracking-widest text-gray-400 uppercase mt-1">{BODA_INFO.mesAlmuerzo}</p>
            </div>
            <div class="w-px h-10 bg-gray-300"></div>
            <div class="text-center">
              <p class="text-3xl text-gray-600 font-light">{BODA_INFO.horaAlmuerzo}</p>
              <p class="text-[9px] tracking-widest text-gray-400 uppercase mt-1">Horas</p>
            </div>
          </div>

          <div class="flex-grow mb-8 w-full">
            <p class="font-bold text-gray-600 mb-2">{BODA_INFO.lugarAlmuerzo}</p>
            <p class="text-sm text-gray-500">{BODA_INFO.direccionAlmuerzo}</p>
          </div>
        </div>

      </div>
    </div>
    
  </div>
  
</section>