---
import { BODA_INFO } from '../data/InfoBoda.js';
---

<section id="itinerary" class="py-10">

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="max-w-10xl soft-card mx-auto p-8 sm:p-12">

      <!-- =====================================================
           ENCABEZADO
           ===================================================== -->

      <div class="text-center mb-12">

        <h2
          class="font-titulo
                 text-4xl sm:text-5xl
                 text-[var(--color-verde)]"
        >
          Cronograma
        </h2>

      </div>


      <!-- =====================================================
           CONTENEDOR DE EVENTOS
           ===================================================== -->

      <div
        class="grid grid-cols-1 md:grid-cols-2
               gap-6 sm:gap-8
               text-center
               items-stretch
               max-w-4xl mx-auto"
      >


        <!-- ===================================================
             TARJETA CEREMONIA
             =================================================== -->

        <div
          class="relative overflow-hidden
                 flex flex-col items-center
                 h-full
                 p-8
                 rounded-3xl
                 shadow-sm
                 transition-all duration-300
                 hover:scale-[1.03]
                 hover:shadow-xl
                 cursor-pointer"
        >

          <div
            class="relative z-10
                   w-full
                   flex flex-col items-center
                   h-full"
          >

            <!-- TÍTULO -->
            <h3
              class="font-subtitulo
                     text-5xl
                     text-[var(--color-titulos)]
                     mb-6"
            >
              Ceremonia
            </h3>


            <!-- =================================================
                 FECHA Y HORA
                 ================================================= -->

            <div
              class="flex items-center justify-center
                     gap-6
                     w-full
                     border-b border-[var(--color-borde-suave)]
                     pb-4 mb-6"
            >

              <!-- FECHA -->

              <div class="text-center">

                <p
                  class="font-palabra
                         text-3xl
                         text-[var(--color-texto)]"
                >
                  {BODA_INFO.fechaCeremonia}
                </p>

                <p
                  class="font-destacado
                         text-[9px]
                         tracking-widest
                         text-[var(--color-verde-claro)]
                         uppercase
                         mt-1"
                >
                  {BODA_INFO.mesCeremonia}
                </p>

              </div>


              <!-- SEPARADOR -->

              <div
                class="w-px h-10
                       bg-[var(--color-verde-claro)]"
              ></div>


              <!-- HORA -->

              <div class="text-center">

                <p
                  class="font-palabra
                         text-3xl
                         text-[var(--color-texto)]"
                >
                  {BODA_INFO.horaCeremonia}
                </p>

                <p
                  class="font-destacado
                         text-[9px]
                         tracking-widest
                         text-[var(--color-verde-claro)]
                         uppercase
                         mt-1"
                >
                  Horas
                </p>

              </div>

            </div>


            <!-- =================================================
                 UBICACIÓN
                 ================================================= -->

            <div class="flex-grow mb-8 w-full">

              <!-- Lugar -->
              <p
                class="font-destacado
                       text-[var(--color-texto)]
                       mb-2"
              >
                {BODA_INFO.salonCeremonia}
              </p>

              <!-- Dirección -->
              <p
                class="font-parrafo
                       text-sm
                       text-[var(--color-texto-suave)]"
              >
                {BODA_INFO.lugarCeremonia}
              </p>

            </div>

          </div>

        </div>


        <!-- ===================================================
             TARJETA ALMUERZO
             =================================================== -->

        <div
          class="relative overflow-hidden
                 flex flex-col items-center
                 h-full
                 p-8
                 rounded-3xl
                 shadow-sm
                 transition-all duration-300
                 hover:scale-[1.03]
                 hover:shadow-xl
                 cursor-pointer"
        >

          <div
            class="relative z-10
                   w-full
                   flex flex-col items-center
                   h-full"
          >

            <!-- TÍTULO -->
            <h3
              class="font-subtitulo
                     text-5xl
                     text-[var(--color-titulos)]
                     mb-6"
            >
              Almuerzo
            </h3>


            <!-- =================================================
                 FECHA Y HORA
                 ================================================= -->

            <div
              class="flex items-center justify-center
                     gap-6
                     w-full
                     border-b border-[var(--color-borde-suave)]
                     pb-4 mb-6"
            >

              <!-- FECHA -->

              <div class="text-center">

                <p
                  class="font-palabra
                         text-3xl
                         text-[var(--color-texto)]"
                >
                  {BODA_INFO.fechaAlmuerzo}
                </p>

                <p
                  class="font-destacado
                         text-[9px]
                         tracking-widest
                         text-[var(--color-verde-claro)]
                         uppercase
                         mt-1"
                >
                  {BODA_INFO.mesAlmuerzo}
                </p>

              </div>


              <!-- SEPARADOR -->

              <div
                class="w-px h-10
                       bg-[var(--color-verde-claro)]"
              ></div>


              <!-- HORA -->

              <div class="text-center">

                <p
                  class="font-palabra
                         text-3xl
                         text-[var(--color-texto)]"
                >
                  {BODA_INFO.horaAlmuerzo}
                </p>

                <p
                  class="font-destacado
                         text-[9px]
                         tracking-widest
                         text-[var(--color-verde-claro)]
                         uppercase
                         mt-1"
                >
                  Horas
                </p>

              </div>

            </div>


            <!-- =================================================
                 UBICACIÓN
                 ================================================= -->

            <div class="flex-grow mb-8 w-full">

              <!-- Lugar -->
              <p
                class="font-destacado
                       text-[var(--color-texto)]
                       mb-2"
              >
                {BODA_INFO.lugarAlmuerzo}
              </p>

              <!-- Dirección -->
              <p
                class="font-parrafo
                       text-sm
                       text-[var(--color-texto-suave)]"
              >
                {BODA_INFO.direccionAlmuerzo}
              </p>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>