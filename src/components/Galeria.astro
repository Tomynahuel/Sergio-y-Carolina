---
import { Image } from 'astro:assets';
import heroImage from '../img/hero.jpg'; // Asegúrate que esta ruta sea correcta

---

<section id="gallery" class="section-shell pb-24">
  <div class="soft-card overflow-hidden p-8 sm:p-10">
    <div class="mb-8 text-center">
      <p class="text-sm uppercase tracking-[0.3em] text-botanical">Galería</p>
      <h2 class="mt-3 font-serif text-4xl text-botanical sm:text-5xl">Nuestros momentos favoritos</h2>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      <div class="group h-72 overflow-hidden rounded-[1.5rem] bg-cover bg-center transition duration-300 hover:scale-[1.02]" style={`background-image: url('${heroImage.src}');`}></div>
      <div class="group h-72 overflow-hidden rounded-[1.5rem] bg-cover bg-center transition duration-300 hover:scale-[1.02]" style={`background-image: url('${heroImage.src}');`}></div>
      <div class="group h-72 overflow-hidden rounded-[1.5rem] bg-cover bg-center transition duration-300 hover:scale-[1.02]" style={`background-image: url('${heroImage.src}');`}></div>
    </div>
  </div>
</section>