---
import foto1 from '../img/ells1.png';
import foto2 from '../img/ellos8.png';
import foto3 from '../img/ellos7.png';
import foto4 from '../img/ells4.png';
import foto5 from '../img/ellos5.jpg';
import foto6 from '../img/ellos8.png';

const imagenes = [
  foto1,
  foto2,
  foto3,
  foto4,
  foto5,
  foto6,
];
---

<section id="gallery" class="section-shell pb-24">
  <div class="soft-card overflow-hidden p-8 sm:p-10">

    <div class="mb-8 text-center">
      <p class="text-sm uppercase tracking-[0.3em] text-[var(--color-verde)]">
        Galería
      </p>

      <h2 class="mt-3 font-serif text-4xl text-[var(--color-texto-fuerte)] sm:text-5xl">
        Nuestros momentos favoritos
      </h2>
    </div>

    <div class="grid gap-4 md:grid-cols-3">

      {
        [0, 1, 2].map((indice) => (
          <div
            class="gallery-image group h-72 overflow-hidden rounded-[1.5rem] bg-[var(--color-blanco)] bg-cover bg-center"
            style={`background-image: url('${imagenes[indice % imagenes.length].src}');`}
            data-indice={indice}
          ></div>
        ))
      }

    </div>
  </div>
</section>

<script>
  const imagenes = [
    foto1.src,
    foto2.src,
    foto3.src,
    foto4.src,
    foto5.src,
    foto6.src,
  ];

  const galerias = document.querySelectorAll<HTMLElement>('.gallery-image');

  let posicion = 0;

  setInterval(() => {
    galerias.forEach((galeria, indice) => {
      const imagenIndex =
        (posicion + indice) % imagenes.length;

      galeria.style.backgroundImage =
        `url('${imagenes[imagenIndex]}')`;
    });

    posicion = (posicion + 1) % imagenes.length;
  }, 3000);
</script>