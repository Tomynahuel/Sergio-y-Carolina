---
import { Image } from 'astro:assets';

// Importamos la imagen de mármol de forma nativa para que Astro la procese sin errores
---

<section id="bienvenida" class="w-full max-w-4xl mx-auto px-4">

  <!-- =====================================================
       ENCABEZADO
       ===================================================== -->

  <div class="text-center mb-8">

    <!-- Iniciales -->
    <p
      class="font-palabra text-3xl text-[var(--color-verde)]"
    >
      S & C
    </p>

    <!-- Título -->
    <h2
      class="font-titulo mt-2 text-4xl sm:text-5xl text-[var(--color-titulos)]"
    >
      Confirmar la Asistencia
    </h2>

  </div>


  <!-- =====================================================
       TARJETA
       ===================================================== -->

  <div
    class="relative overflow-hidden rounded-[2rem]
           p-8 sm:p-12
           shadow-sm
           border border-[var(--color-borde)]
           bg-[var(--color-blanco)]
           transition-all duration-300
           hover:shadow-md"
  >

    <!-- Capa aclaradora -->
    <div
      class="absolute inset-0
             bg-[var(--color-overlay-suave)]
             z-0"
    ></div>


    <!-- ===================================================
         CONTENIDO
         =================================================== -->

    <div class="relative z-10 text-center">

      <p
        class="font-parrafo
               text-2xl md:text-xl
               text-[var(--color-texto)]
               leading-relaxed"
      >
        Qué alegría inmensa compartir este momento tan especial
        con vos. Estamos preparando una noche inolvidable.
      </p>

    </div>

  </div>

</section>