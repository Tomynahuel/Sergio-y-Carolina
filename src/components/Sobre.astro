---
import { BODA_INFO } from '../data/InfoBoda.js';
import { Image } from 'astro:assets';

// Asegúrate de que BODA_INFO.BotonSobre ahora apunte a tu archivo "deco-boton.jpg"
---

<div id="sobre-overlay" class="overlay relative >">
  <!-- Fondo del sobre completo (sobre3.png) -->
  <Image src={BODA_INFO.sobre} alt="Sobre cerrado" class="sobre-bg" />

  <!-- Botón central redondo con el sello de cera (Capa superior) -->
  <button id="btn-abrir" class="boton-abrir">
    <Image src={BODA_INFO.BotonSobre} alt="Sello de cera" class="sello-imagen" />
  </button>
</div>

<style>
  /* --- CONTROL DEL SCROLL --- */
  :global(body) {
    overflow: hidden;
  }

  :global(body.scroll-permitido) {
    overflow: auto;
    overflow-x: hidden;
  }

  /* --- ESTILOS DEL SOBRE (PANTALLA COMPLETA) --- */
  .overlay {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100dvh;
  z-index: 99999;

  display: flex;
  justify-content: center;
  align-items: center;

  background-color: #f2f2f2;

  opacity: 1;
  transition: opacity 1.5s ease;

  overflow: hidden;
}

  /* Estilos para la imagen del sobre completo */
  .sobre-bg {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center center;

  z-index: 1;

  image-rendering: high-quality;
  transform: translateZ(0);
  will-change: transform;
}

  /* --- ESTILOS DEL BOTÓN REDONDO (EL SELLO) --- */
  .boton-abrir {
  position: absolute;

  left: 49.3%;
  top: 60%;

  transform: translate(-50%, -50%);

  z-index: 100000;

  width: clamp(115px, 18vw, 180px);
  height: clamp(115px, 18vw, 180px);

  display: flex;
  justify-content: center;
  align-items: center;

  background: transparent;
  border: none;
  cursor: pointer;

  /* Sin movimiento */
  transition: none;
}


  /* Estilos para que la imagen ocupe todo el botón */
  .sello-imagen {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply; 
    filter: drop-shadow(0px 8px 12px rgba(0, 0, 0, 0.4)); 
    transition: filter 0.3s ease;
  }


  /* -------------------------------------
     CLASES DE ANIMACIÓN (Cuando se abre)
     ------------------------------------- */
     
  .overlay.is-open {
    opacity: 0; /* Simplemente desvanecemos todo el contenedor en su sitio */
    pointer-events: none; 
  }
</style>

<script>
  const btn = document.getElementById('btn-abrir');
  const overlay = document.getElementById('sobre-overlay');

  const SOBRE_ABIERTO_KEY = 'invitacion-sobre-abierto';

  if (overlay) {
    const sobreYaFueAbierto =
  !import.meta.env.DEV &&
  localStorage.getItem(SOBRE_ABIERTO_KEY) === 'true';

    if (sobreYaFueAbierto) {
      overlay.remove();
      document.body.classList.add('scroll-permitido');
    } else {
      document.body.classList.remove('scroll-permitido');
    }
  }

  if (btn && overlay) {
    btn.addEventListener('click', () => {

      // Guardamos que el invitado ya abrió el sobre
      localStorage.setItem(SOBRE_ABIERTO_KEY, 'true');

      // Comenzamos la animación de apertura
      overlay.classList.add('is-open');

      // Permitimos nuevamente el scroll
      document.body.classList.add('scroll-permitido');

      // Eliminamos completamente el overlay
      setTimeout(() => {
        overlay.remove();
      }, 1500);
    });
  }
</script>