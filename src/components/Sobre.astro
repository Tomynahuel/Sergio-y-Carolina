---
// src/components/SobreAnimado.astro
---

<div
  x-data="{
    abierto: false,
    
    iniciar() {
      // Bloqueamos el scroll para evitar que bajen antes de tiempo
      document.body.style.overflow = 'hidden';
    },
    
    abrirInvitacion() {
      this.abierto = true;
      document.body.style.overflow = 'auto';
      
      // Reproducción de audio
      const reproductor = document.getElementById('player') || document.querySelector('audio');
      if (reproductor) {
        reproductor.play().catch(e => console.log('Autoplay bloqueado'));
      }
      
      // Borramos la portada completa del DOM tras finalizar la animación
      setTimeout(() => {
        this.$el.style.display = 'none';
      }, 1500);
    }
  }"
  x-init="iniciar()"
  class="fixed inset-0 z-[999] select-none overflow-hidden"
>
  <div 
    class="absolute top-0 left-0 w-full h-1/2 bg-[#f4f1ea] transition-transform duration-[1500ms] ease-[cubic-bezier(0.7,0,0.3,1)] overflow-hidden border-b border-[#e4ded5]/30"
    :class="abierto ? '-translate-y-full' : 'translate-y-0'"
  >
    <div 
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/img/sobre.png'); height: 200vh; top: 0;"
    ></div>
    <div class="absolute inset-0 bg-black/20"></div>
  </div>

  <div 
    class="absolute bottom-0 left-0 w-full h-1/2 bg-[#f4f1ea] transition-transform duration-[1500ms] ease-[cubic-bezier(0.7,0,0.3,1)] overflow-hidden border-t border-[#e4ded5]/30"
    :class="abierto ? 'translate-y-full' : 'translate-y-0'"
  >
    <div 
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/img/sobre2.png'); height: 200vh; bottom: 0;"
    ></div>
    <div class="absolute inset-0 bg-black/20"></div>
  </div>

  <div 
    class="absolute inset-0 z-20 flex flex-col items-center justify-center text-white px-4 text-center transition-all duration-[1000ms] ease-out"
    :class="abierto ? 'opacity-0 scale-95 pointer-events-none' : 'opacity-100 scale-100'"
  >
    <h1 class="font-serif text-5xl md:text-7xl tracking-wide mb-2 drop-shadow-md">
      Sergio <span class="font-light text-sage">&</span> Carolina
    </h1>
    
    <p class="font-sans text-xs md:text-sm tracking-[0.4em] uppercase mb-16 text-[#f4f1ea] drop-shadow-sm">
      ¡Nos Casamos!
    </p>
    
    <button 
      @click="abrirInvitacion()"
      class="group relative overflow-hidden px-10 py-3 rounded-full border border-white/60 bg-white/10 backdrop-blur-md transition-all duration-300 hover:bg-white hover:text-botanical cursor-pointer shadow-lg hover:shadow-xl active:scale-95"
    >
      <span class="font-sans text-sm tracking-[0.2em] uppercase transition-colors duration-300">
        Abrir
      </span>
    </button>
  </div>
</div>