---
import { BODA_INFO } from '../data/InfoBoda.js';
import { Image } from 'astro:assets';

// Asegúrate de que BODA_INFO.BotonSobre ahora apunte a tu archivo "deco-boton.jpg"
---

<div id="sobre-overlay" class="overlay">
  <!-- Fondo del sobre completo (sobre3.png) -->
  <Image src={BODA_INFO.sobre} alt="Sobre cerrado" class="sobre-bg" />

  <!-- Botón central redondo con el sello de cera (Capa superior) -->
  <button id="btn-abrir" class="boton-abrir">
    <Image src={BODA_INFO.BotonSobre} alt="Sello de cera" class="sello-imagen" />
  </button>
</div>

<style>
  /* --- CONTROL DEL SCROLL --- */
  :global(body) {
    overflow: hidden;
  }

  :global(body.scroll-permitido) {
    overflow: auto;
    overflow-x: hidden;
  }

  /* --- ESTILOS DEL SOBRE (PANTALLA COMPLETA) --- */
  .overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #f2f2f2; 
    opacity: 1; /* Agregamos la opacidad base */
    /* Cambiamos la transición para que maneje la opacidad de TODO el conjunto */
    transition: opacity 1.5s ease; 
  }

  /* Estilos para la imagen del sobre completo */
  .sobre-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    object-fit: cover; 
    object-position: center; 
    z-index: 1;
    
    /* TRUCOS ANTI-DIENTES DE SIERRA */
    image-rendering: high-quality; 
    transform: translateZ(0); 
    will-change: transform; 
  }

  /* --- ESTILOS DEL BOTÓN REDONDO (EL SELLO) --- */
  .boton-abrir {
    position: relative;
    z-index: 100000;
    width: 150px; 
    height: 150px;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: transparent; 
    border: none;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .boton-abrir:hover {
    transform: scale(1.05);
  }

  /* Estilos para que la imagen ocupe todo el botón */
  .sello-imagen {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply; 
    filter: drop-shadow(0px 8px 12px rgba(0, 0, 0, 0.4)); 
    transition: filter 0.3s ease;
  }

  .boton-abrir:hover .sello-imagen {
    filter: drop-shadow(0px 12px 18px rgba(0, 0, 0, 0.5)); 
  }

  /* -------------------------------------
     CLASES DE ANIMACIÓN (Cuando se abre)
     ------------------------------------- */
     
  .overlay.is-open {
    opacity: 0; /* Simplemente desvanecemos todo el contenedor en su sitio */
    pointer-events: none; 
  }
</style>

<script>
  const btn = document.getElementById('btn-abrir');
  const overlay = document.getElementById('sobre-overlay');

  if (btn && overlay) {
    btn.addEventListener('click', () => {
      overlay.classList.add('is-open');
      document.body.classList.add('scroll-permitido');
      
      setTimeout(() => {
        overlay.style.display = 'none';
      }, 1500); 
    });
  }
</script>