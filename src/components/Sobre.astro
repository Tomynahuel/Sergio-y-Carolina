---
import { BODA_INFO } from '../data/InfoBoda.js';
import { Image } from 'astro:assets';

// Asegúrate de que la ruta coincida con donde guardaste la imagen
---

<div id="sobre-overlay" class="overlay">
  <!-- Mitad superior del sobre (Capa de fondo) -->
  <Image src={BODA_INFO.sobre} alt="Parte superior del sobre" class="sobre-top" />

  <!-- Plantas superpuestas (Capa intermedia) -->
  <Image src={BODA_INFO.MarcoSobre} alt="Decoración de plantas" class="plantas-decoracion" />

  <!-- Botón central redondo (Capa superior) -->
  <button id="btn-abrir" class="boton-abrir">
    <div class="flex items-center justify-center gap-2 font-serif text-3xl font-semibold tracking-widest text-slate-900">
      <Image src={BODA_INFO.BotonSobre} alt="Anillo" class="h-70 w-70 object-contain" />
    </div>
  </button>
</div>

<style>
  /* --- CONTROL DEL SCROLL --- */
  :global(body) {
    overflow: hidden;
  }

  :global(body.scroll-permitido) {
    overflow: auto;
    overflow-x: hidden;
  }

  /* --- ESTILOS DEL SOBRE (PANTALLA COMPLETA) --- */
  .overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: rgb(226, 224, 224);
    transition: background-color 1.5s ease, visibility 1.5s ease;
  }

  /* Estilos para la imagen del sobre */
  .sobre-top {
    position: absolute;
    left: 0;
    width: 100vw;
    object-fit: cover; 
    transition: transform 1.5s cubic-bezier(0.25, 0.8, 0.25, 1);
    top: 0;
    height: 52vh; 
    transform-origin: top;
    z-index: 1;
    filter: drop-shadow(0px 15px 25px rgba(17, 17, 17, 0.4));
  }

  /* --- ESTILOS DE LAS PLANTAS SUPERPUESTAS --- */
 /* --- ESTILOS DE LAS PLANTAS SUPERPUESTAS --- */
  .plantas-decoracion {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    /* Cambiamos 'cover' por 'contain' para mostrar la imagen completa sin recortes */
    /*object-fit: fill; */
    /*z-index: 2; */
    pointer-events: none; 
    /*mix-blend-mode: multiply; */
    transition: opacity 1s ease;
    opacity: 0.50%;
  }

  /* --- ESTILOS DEL BOTÓN REDONDO --- */
  .boton-abrir {
    position: relative;
    z-index: 100000;
    width: 140px;
    height: 140px;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #c5a880;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
    transition: transform 0.3s ease, opacity 0.5s ease, box-shadow 0.3s ease;
  }

  .boton-abrir:hover {
    transform: scale(1.05);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }

  /* -------------------------------------
     CLASES DE ANIMACIÓN (Cuando se abre)
     ------------------------------------- */
     
  .overlay.is-open {
    background-color: transparent; 
    pointer-events: none; 
  }

  /* sobre.png va hacia arriba fuera de la pantalla */
  .overlay.is-open .sobre-top {
    transform: translateY(-100%);
  }

  /* Las plantas simplemente se desvanecen en su lugar sin moverse */
  .overlay.is-open .plantas-decoracion {
    opacity: 0;
  }

  /* El botón desaparece y se encoge */
  .overlay.is-open .boton-abrir {
    opacity: 0;
    transform: scale(0);
  }
</style>

<script>
  const btn = document.getElementById('btn-abrir');
  const overlay = document.getElementById('sobre-overlay');

  if (btn && overlay) {
    btn.addEventListener('click', () => {
      overlay.classList.add('is-open');
      document.body.classList.add('scroll-permitido');
      
      setTimeout(() => {
        overlay.style.display = 'none';
      }, 1500); 
    });
  }
</script>