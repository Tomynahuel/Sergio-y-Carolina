---
import { BODA_INFO } from '../data/InfoBoda.js';
import { Image } from 'astro:assets';
---

<div id="sobre-overlay" class="overlay">

  <!-- SOBRE -->
  <button id="btn-abrir" class="sobre-boton">
    <Image
      src={BODA_INFO.sobre}
      alt="Abrir invitación"
      class="sobre-bg"
    />
  </button>

  <!-- CAPA NEGRA -->
  <div class="pantalla-negra"></div>

</div>

<style>
  /* ==============================
     SCROLL
  ============================== */

  :global(body) {
    overflow: hidden;
  }

  :global(body.scroll-permitido) {
    overflow: auto;
    overflow-x: hidden;
  }


  /* ==============================
     OVERLAY
  ============================== */

  .overlay {
    position: fixed;
    inset: 0;

    width: 100vw;
    height: 100dvh;

    z-index: 99999;

    background: #000;

    overflow: hidden;
  }


  /* ==============================
     SOBRE
  ============================== */

  .sobre-boton {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    padding: 0;
    margin: 0;

    border: none;
    background: transparent;

    cursor: pointer;

    z-index: 1;
  }


  .sobre-bg {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    pointer-events: none;
  }


  /* ==============================
     PANTALLA NEGRA
  ============================== */

  .pantalla-negra {
    position: absolute;
    inset: 0;

    z-index: 2;

    background: #000;

    opacity: 0;

    pointer-events: none;
  }


  /* ==============================
     OSCURECER
  ============================== */

  .overlay.oscureciendo .pantalla-negra {
    opacity: 1;

    transition:
      opacity 1.2s ease-in;
  }


  /* ==============================
     OCULTAR SOBRE
     ESTAMOS COMPLETAMENTE EN NEGRO
  ============================== */

  .overlay.sobre-oculto .sobre-boton {
    visibility: hidden;
  }


  /* ==============================
     REVELAR INVITACIÓN
  ============================== */

  .overlay.revelando .pantalla-negra {
    opacity: 0;

    transition:
      opacity 2.5s ease-out;
  }

</style>

<script>
  /*
   * ==========================================
   * CONFIGURACIÓN DEL SOBRE
   * ==========================================
   *
   * true  → mostrar el sobre SIEMPRE
   * false → mostrarlo solo la primera vez
   */
  const MOSTRAR_SOBRE_SIEMPRE = false;
  const SOBRE_ABIERTO_KEY = 'invitacion-sobre-abierto';
  const btn = document.getElementById('btn-abrir');
  const overlay = document.getElementById('sobre-overlay');

  if (overlay) {
    /*
     * ==========================================
     * DECIDIR SI MOSTRAR EL SOBRE
     * ==========================================
     */
    const sobreYaFueAbierto =
      localStorage.getItem(SOBRE_ABIERTO_KEY) === 'true';
    /*
     * MOSTRAR SIEMPRE
     */
    if (MOSTRAR_SOBRE_SIEMPRE) {
      document.body.classList.remove(
        'scroll-permitido'
      );
    }
    /*
     * MOSTRAR SOLO LA PRIMERA VEZ
     */
    else if (!sobreYaFueAbierto) {
      document.body.classList.remove(
        'scroll-permitido'
      );
    }
    /*
     * YA FUE ABIERTO
     */
    else {
      overlay.remove();
      document.body.classList.add(
        'scroll-permitido'
      );
    }
  }
  /*
   * ==========================================
   * ABRIR SOBRE
   * ==========================================
   */

  if (btn && overlay) {

    btn.addEventListener('click', () => {

      btn.disabled = true;


      /*
       * Guardamos que el invitado
       * ya abrió el sobre.
       *
       * Esto solo tendrá efecto cuando
       * MOSTRAR_SOBRE_SIEMPRE = false.
       */

      localStorage.setItem(
        SOBRE_ABIERTO_KEY,
        'true'
      );


      /*
       * OSCURECER
       */

      overlay.classList.add(
        'oscureciendo'
      );


      /*
       * ESPERAR A QUE ESTÉ COMPLETAMENTE NEGRO
       */

      setTimeout(() => {

        /*
         * Ocultamos el sobre mientras
         * todavía estamos en negro.
         */

        overlay.classList.add(
          'sobre-oculto'
        );


        /*
         * Permitimos el scroll
         */

        document.body.classList.add(
          'scroll-permitido'
        );


        /*
         * REVELAR INVITACIÓN
         */

        requestAnimationFrame(() => {

          overlay.classList.add(
            'revelando'
          );

        });


        /*
         * ELIMINAR TRANSICIÓN
         */

        setTimeout(() => {

          overlay.remove();

        }, 2500);

      }, 1200);

    });

  }
</script>