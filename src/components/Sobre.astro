---
import { BODA_INFO } from '../data/InfoBoda.js';
import { Image } from 'astro:assets';
---

<div id="sobre-overlay" class="overlay">

  <!-- SOBRE -->
  <button id="btn-abrir" class="sobre-boton">
    <Image
      src={BODA_INFO.sobre}
      alt="Abrir invitación"
      class="sobre-bg"
    />
  </button>

  <!-- CAPA NEGRA -->
  <div class="pantalla-negra"></div>

</div>

<style>
  /* ==============================
     SCROLL
  ============================== */

  :global(body) {
    overflow: hidden;
  }

  :global(body.scroll-permitido) {
    overflow: auto;
    overflow-x: hidden;
  }


  /* ==============================
     OVERLAY
  ============================== */

  .overlay {
    position: fixed;
    inset: 0;

    width: 100vw;
    height: 100dvh;

    z-index: 99999;

    background: #000;

    overflow: hidden;
  }


  /* ==============================
     SOBRE
  ============================== */

  .sobre-boton {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    padding: 0;
    margin: 0;

    border: none;
    background: transparent;

    cursor: pointer;

    z-index: 1;
  }


  .sobre-bg {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    pointer-events: none;
  }


  /* ==============================
     PANTALLA NEGRA
  ============================== */

  .pantalla-negra {
    position: absolute;
    inset: 0;

    z-index: 2;

    background: #000;

    opacity: 0;

    pointer-events: none;
  }


  /* ==============================
     OSCURECER
  ============================== */

  .overlay.oscureciendo .pantalla-negra {
    opacity: 1;

    transition:
      opacity 1.2s ease-in;
  }


  /* ==============================
     OCULTAR SOBRE
     ESTAMOS COMPLETAMENTE EN NEGRO
  ============================== */

  .overlay.sobre-oculto .sobre-boton {
    visibility: hidden;
  }


  /* ==============================
     REVELAR INVITACIÓN
  ============================== */

  .overlay.revelando .pantalla-negra {
    opacity: 0;

    transition:
      opacity 2.5s ease-out;
  }

</style>

<script>
  const btn = document.getElementById('btn-abrir');
  const overlay = document.getElementById('sobre-overlay');

  const SOBRE_ABIERTO_KEY = 'invitacion-sobre-abierto';


  /* =================================
     COMPROBAR SI YA FUE ABIERTO
  ================================= */

  if (overlay) {

    const sobreYaFueAbierto =
      !import.meta.env.DEV &&
      localStorage.getItem(SOBRE_ABIERTO_KEY) === 'true';


    if (sobreYaFueAbierto) {

      overlay.remove();

      document.body.classList.add(
        'scroll-permitido'
      );

    } else {

      document.body.classList.remove(
        'scroll-permitido'
      );

    }
  }


  /* =================================
     ABRIR INVITACIÓN
  ================================= */

  if (btn && overlay) {

    btn.addEventListener('click', () => {

      /* Evitar doble click */
      btn.disabled = true;


      /* Guardar estado */
      localStorage.setItem(
        SOBRE_ABIERTO_KEY,
        'true'
      );


      /* ==========================
         1. SOBRE → NEGRO
      ========================== */

      overlay.classList.add(
        'oscureciendo'
      );


      /* ==========================
         2. ESPERAR NEGRO TOTAL
      ========================== */

      setTimeout(() => {

        /*
         * Ahora estamos completamente
         * en negro.
         */

        overlay.classList.add(
          'sobre-oculto'
        );


        /*
         * Habilitamos la invitación.
         */
        document.body.classList.add(
          'scroll-permitido'
        );


        /* ==========================
           3. NEGRO → INVITACIÓN
        ========================== */

        /*
         * Pequeña pausa para garantizar
         * que el navegador registre que
         * el sobre desapareció antes
         * de comenzar el fade.
         */

        requestAnimationFrame(() => {

          overlay.classList.add(
            'revelando'
          );

        });


        /* ==========================
           4. ELIMINAR OVERLAY
        ========================== */

        setTimeout(() => {

          overlay.remove();

        }, 2500);

      }, 1200);

    });

  }
</script>