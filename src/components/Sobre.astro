---
import { Image } from 'astro:assets';
import sobre from "../img/sobre.png"
import sobre2 from "../img/sobre2.png"
---

<div
  x-data="{ 
    abierto: false, 
    overlayOculto: false, 
    iniciar() { document.body.style.overflow = 'hidden'; }, 
    abrirInvitacion() { 
        this.abierto = true; 
        const audio = document.getElementById('player') || document.querySelector('audio'); 
        if (audio) audio.play().catch(() => {}); 
        setTimeout(() => { 
            this.overlayOculto = true; 
            document.body.style.overflow = 'auto'; 
            setTimeout(() => this.$el.style.display = 'none', 1000); 
        }, 1000); 
    } 
  }"
  x-init="iniciar()"
  class="fixed inset-0 z-[999] flex flex-col items-center justify-center bg-botanical transition-opacity duration-1000 ease-in-out"
  :class="overlayOculto ? 'opacity-0 pointer-events-none' : 'opacity-100'"
>
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-black/40 z-10"></div>

    <div class="absolute inset-x-0 top-0 h-1/2 z-0 transition-all duration-1000 ease-in-out"
         :class="abierto ? 'opacity-0 -translate-y-full' : 'opacity-100 translate-y-0'">
      <Image src={sobre} alt="Solapa" class="w-full h-full object-cover object-top" />
    </div>

    <div class="absolute inset-x-0 bottom-0 h-1/2 z-0 transition-all duration-1000 ease-in-out"
         :class="abierto ? 'opacity-0 translate-y-full' : 'opacity-100 translate-y-0'">
      <Image src={sobre2} alt="Cuerpo" class="w-full h-full object-cover object-bottom" />
    </div>
  </div>

  <div class="relative z-20 flex flex-col items-center text-white px-4 text-center">
    <h1 class="font-serif text-5xl md:text-7xl tracking-wide mb-2">
      Sergio <span class="font-light text-sage">&</span> Carolina
    </h1>
    <p class="font-sans text-xs md:text-sm tracking-[0.4em] uppercase mb-16 text-[#f4f1ea]">¡Nos Casamos!</p>
    <button @click="abrirInvitacion()" class="group relative overflow-hidden px-10 py-3 rounded-full border border-white/50 bg-white/10 backdrop-blur-sm transition-all duration-300 hover:bg-white hover:text-botanical cursor-pointer">
      <span class="font-sans text-sm tracking-[0.2em] uppercase transition-colors duration-300">Abrir</span>
    </button>
  </div>
</div>