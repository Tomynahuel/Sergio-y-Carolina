---
import { BODA_INFO } from "../data/InfoBoda.js";
import { Image } from "astro:assets";
---

<div id="sobre-overlay" class="overlay">
  <!-- =====================================================
       SOBRE
       ===================================================== -->

  <button
    id="btn-abrir"
    class="sobre-boton"
    type="button"
    aria-label="Abrir invitación"
  >
    <Image
      src={BODA_INFO.sobre}
      alt="Abrir invitación"
      class="sobre-bg"
    />
  </button>

  <!-- =====================================================
       CAPA NEGRA
       ===================================================== -->

  <div class="pantalla-negra"></div>
</div>

<style>
  /* ==============================
     SCROLL
  ============================== */

  :global(body) {
    overflow: hidden;
  }

  :global(body.scroll-permitido) {
    overflow: auto;
    overflow-x: hidden;
  }

  /* ==============================
     OVERLAY
  ============================== */

  .overlay {
    position: fixed;
    inset: 0;

    width: 100vw;
    height: 100dvh;

    z-index: 99999;

    background: #000;

    overflow: hidden;
  }

  /* ==============================
     SOBRE
  ============================== */

  .sobre-boton {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    padding: 0;
    margin: 0;

    border: none;
    background: transparent;

    cursor: pointer;

    z-index: 1;
  }

  .sobre-boton:disabled {
    cursor: default;
  }

  .sobre-bg {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    pointer-events: none;

    user-select: none;
  }

  /* ==============================
     PANTALLA NEGRA
  ============================== */

  .pantalla-negra {
    position: absolute;
    inset: 0;

    z-index: 2;

    background: #000;

    opacity: 0;

    pointer-events: none;
  }

  /* ==============================
     OSCURECER
  ============================== */

  .overlay.oscureciendo .pantalla-negra {
    opacity: 1;

    transition: opacity 1.2s ease-in;
  }

  /* ==============================
     OCULTAR SOBRE
     ESTAMOS COMPLETAMENTE EN NEGRO
  ============================== */

  .overlay.sobre-oculto .sobre-boton {
    visibility: hidden;
  }

  /* ==============================
     REVELAR INVITACIÓN
  ============================== */

  .overlay.revelando .pantalla-negra {
    opacity: 0;

    transition: opacity 2.5s ease-out;
  }
</style>

<script>
  /*
   * =====================================================
   * CONFIGURACIÓN DEL SOBRE
   * =====================================================
   *
   * true
   * → El sobre aparece cada vez que se ingresa.
   *
   * false
   * → El sobre aparece solamente la primera vez.
   */

  const MOSTRAR_SOBRE_SIEMPRE = false;

  const SOBRE_ABIERTO_KEY =
    "invitacion-sobre-abierto";

  const btn =
    document.getElementById("btn-abrir");

  const overlay =
    document.getElementById("sobre-overlay");

  /*
   * =====================================================
   * DECIDIR SI MOSTRAR EL SOBRE
   * =====================================================
   */

  if (overlay) {
    const sobreYaFueAbierto =
      localStorage.getItem(SOBRE_ABIERTO_KEY) ===
      "true";

    /*
     * -----------------------------------------------------
     * MOSTRAR SIEMPRE
     * -----------------------------------------------------
     */

    if (MOSTRAR_SOBRE_SIEMPRE) {
      document.body.classList.remove(
        "scroll-permitido",
      );
    }

    /*
     * -----------------------------------------------------
     * PRIMERA VEZ
     * -----------------------------------------------------
     */

    else if (!sobreYaFueAbierto) {
      document.body.classList.remove(
        "scroll-permitido",
      );
    }

    /*
     * -----------------------------------------------------
     * YA FUE ABIERTO
     * -----------------------------------------------------
     */

    else {
      overlay.remove();

      document.body.classList.add(
        "scroll-permitido",
      );
    }
  }

  /*
   * =====================================================
   * ABRIR SOBRE
   * =====================================================
   */

  if (btn && overlay) {
    btn.addEventListener("click", () => {
      /*
       * ===================================================
       * MÚSICA
       * ===================================================
       *
       * IMPORTANTE:
       *
       * Esta llamada ocurre directamente dentro del
       * evento "click".
       *
       * De esta forma el navegador considera que el
       * usuario interactuó con la página y permite
       * reproducir el audio.
       */

      if (
        typeof window.iniciarMusica ===
        "function"
      ) {
        window.iniciarMusica();
      }

      /*
       * ===================================================
       * BLOQUEAR DOBLE CLICK
       * ===================================================
       */

      btn.disabled = true;

      /*
       * ===================================================
       * GUARDAR ESTADO
       * ===================================================
       *
       * Esto solamente tiene efecto cuando:
       *
       * MOSTRAR_SOBRE_SIEMPRE = false
       */

      localStorage.setItem(
        SOBRE_ABIERTO_KEY,
        "true",
      );

      /*
       * ===================================================
       * OSCURECER
       * ===================================================
       */

      overlay.classList.add(
        "oscureciendo",
      );

      /*
       * ===================================================
       * ESPERAR A QUE ESTÉ COMPLETAMENTE NEGRO
       * ===================================================
       */

      setTimeout(() => {
        /*
         * -------------------------------------------------
         * OCULTAR SOBRE
         * -------------------------------------------------
         *
         * La pantalla todavía está completamente negra.
         */

        overlay.classList.add(
          "sobre-oculto",
        );

        /*
         * -------------------------------------------------
         * PERMITIR SCROLL
         * -------------------------------------------------
         */

        document.body.classList.add(
          "scroll-permitido",
        );

        /*
         * -------------------------------------------------
         * REVELAR INVITACIÓN
         * -------------------------------------------------
         */

        requestAnimationFrame(() => {
          overlay.classList.add(
            "revelando",
          );
        });

        /*
         * -------------------------------------------------
         * ELIMINAR OVERLAY
         * -------------------------------------------------
         *
         * Coincide con la duración de la transición
         * de revelado: 2.5 segundos.
         */

        setTimeout(() => {
          overlay.remove();
        }, 2500);
      }, 1200);
    });
  }
</script>