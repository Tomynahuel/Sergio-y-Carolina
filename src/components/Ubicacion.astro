---
import { BODA_INFO } from "../data/InfoBoda.js";
---

<section class="section-shell pb-24">
  <div class="soft-card overflow-hidden p-8 sm:p-10">
    <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <!-- Información -->
      <div class="relative overflow-hidden rounded-[1.5rem] p-6 sm:p-8">
        <!-- Contenido -->
        <div class="relative z-10">
          <!-- Etiqueta -->
          <p
            class="text-sm font-destacado uppercase tracking-[0.3em] text-[var(--color-verde)]"
          >
            Ubicación
          </p>

          <!-- Título -->
          <h2
            class="mt-3 text-4xl font-[var(--font-titulo)] text-[var(--color-titulo)] sm:text-5xl"
          >
            Estamos esperándote
          </h2>

          <!-- Descripción -->
          <p
            class="mt-4 text-lg font-[var(--font-titulo)] text-[var(--color-bordo)]"
          >
            El evento será en un lugar especial, con ambiente íntimo y hermoso
            para compartir este día tan importante.
          </p>
          <!-- Información del salón -->
          <div
            class="bg-[var(--color-verde-claro)]/10 mt-6 rounded-[1.5rem] font-[var(--font-texto)] text-[var(--color-parrafo-fuerte)]"
          >
            <p class=" font-destacado text-2xl text-[var(--color-negro)]">
              Salón de Eventos: Colectividad Paraguaya
            </p>
            <p class="mt-2 text-[var(--color-verde)] ">
              {BODA_INFO.ubiEvento}
            </p>
          </div>
        </div>
      </div>
      <!-- Mapa -->
      <div
        class="relative overflow-hidden rounded-[1.5rem] border border-[var(--color-borde-suave)] p-2"
      >
        <div class="relative z-10 overflow-hidden rounded-[1.2rem]">
          <iframe
            src={BODA_INFO.linkMaps}
            class="h-72 w-full"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Mapa del lugar"></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
