---
import '../styles/global.css';
import { BODA_INFO } from '../data/InfoBoda.js';

// WhatsApp
const numeroWhatsApp = BODA_INFO.whatsappContacto.replace(/\D/g, '');

const mensajeWhatsApp = encodeURIComponent(
  '¡Hola! Me encantaría ver la lista de regalos para la boda. 🎁'
);

const linkWhatsApp = `https://wa.me/${numeroWhatsApp}?text=${mensajeWhatsApp}`;
---

<section id="regalos" class="flex py-10">
  <div class="max-w-7xl mx-auto px-4 w-full sm:px-6 lg:px-8">

    <!-- Contenedor Maestro -->
    <div class="soft-card w-full mx-auto rounded-[36px] shadow-sm p-8 sm:p-12">

      <!-- Título -->
      <div class="text-center mb-12">
        <h2 class="font-serif text-4xl text-[var(--color-verde)] sm:text-5xl">
          Regalos
        </h2>
      </div>

      <!-- Grilla -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 sm:gap-14 text-center items-stretch max-w-5xl mx-auto">

        <!-- ================================================= -->
        <!-- TARJETA 1: MESA DE REGALOS -->
        <!-- ================================================= -->

        <div
          class="relative overflow-hidden flex flex-col h-full justify-between items-center p-8 rounded-3xl border border-[var(--color-borde-suave)] shadow-sm transition-all duration-300 hover:scale-[1.03] hover:shadow-xl"
        >
          <!-- Contenido -->
          <div class="relative z-10 w-full flex flex-col items-center">

            <div class="mb-6">
              <h2 class="font-serif text-3xl text-[var(--color-texto)] sm:text-4xl">
                Mesa de regalos
              </h2>
            </div>

            <!-- Icono -->
            <div class="mb-6 h-16 flex items-center justify-center text-[var(--color-bordo-rosa)]">
              <svg
                class="w-12 h-12"
                fill="none"
                stroke="currentColor"
                stroke-width="0.85"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"
                />
              </svg>
            </div>

            <p class="text-[var(--color-texto-suave)] mb-8 max-w-sm leading-relaxed text-lg">
              Si preferís hacernos un presente físico, presioná el botón para
              conocer nuestra lista de regalos. ¡O también podés hacer un
              regalo económico a través de nuestro alias!
            </p>

          </div>

          <!-- Botón WhatsApp -->
          <a
            href={linkWhatsApp}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-10 bg-[var(--color-verde)] hover:bg-[var(--color-bordo)] hover:text-[var(--color-blanco)] transition-colors text-[var(--color-blanco)] text-xs font-bold tracking-widest uppercase py-3 px-8 rounded-full mt-auto w-full max-w-[220px]"
          >
            Ver lista de regalos
          </a>

        </div>


        <!-- ================================================= -->
        <!-- TARJETA 2: DATOS BANCARIOS -->
        <!-- ================================================= -->

        <div
          class="relative overflow-hidden flex flex-col h-full justify-between items-center p-8 sm:p-10 rounded-3xl border border-[var(--color-borde-suave)] shadow-sm transition-all duration-300 hover:scale-[1.03] hover:shadow-xl"
        >

          

          <!-- Contenido -->
          <div class="relative z-10 w-full flex flex-col items-center">

            <!-- Icono -->
            <div class="mb-6 h-16 flex items-center justify-center text-[var(--color-bordo-rosa)]">
              <svg
                class="w-14 h-14"
                fill="none"
                stroke="currentColor"
                stroke-width="0.85"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z"
                />
              </svg>
            </div>

            <!-- Datos -->
            <div class="w-full max-w-sm text-center mb-8">

              <p class="text-[11px] tracking-[0.3em] text-[var(--color-rosa)] uppercase font-bold mb-3">
                Alias
              </p>

              <p
                id="alias-boda"
                class="text-[var(--color-texto-fuerte)] text-xl md:text-2xl uppercase tracking-wider font-semibold mb-4"
              >
                {BODA_INFO.aliasBoda}
              </p>

              <div class="border-t border-dashed border-[var(--color-borde-suave)] w-3/4 mx-auto my-4"></div>

              <p class="text-4xl text-[var(--color-texto)] font-serif mt-4">
                {BODA_INFO.dueñoCuenta}
              </p>

            </div>

          </div>

          <!-- Botón copiar -->
          <button
            id="btn-copiar"
            class="relative z-10 bg-[var(--color-verde)] hover:bg-[var(--color-bordo)] transition-colors text-[var(--color-blanco)] text-xs font-bold tracking-widest uppercase py-3 px-8 rounded mt-auto w-full max-w-[240px] shadow-sm flex items-center justify-center gap-2"
          >
            <span id="texto-btn-copiar">Copiar Datos</span>
          </button>

        </div>

      </div>
    </div>
  </div>
</section>


<!-- Script para copiar alias -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnCopiar = document.getElementById('btn-copiar');
    const textoBtn = document.getElementById('texto-btn-copiar');
    const aliasBoda = document.getElementById('alias-boda');

    if (btnCopiar && aliasBoda) {
      btnCopiar.addEventListener('click', async () => {
        try {
          const textoACopiar = aliasBoda.innerText.trim();

          await navigator.clipboard.writeText(textoACopiar);

          const textoOriginal = textoBtn.innerText;

          textoBtn.innerText = '¡Alias Copiado!';

          btnCopiar.classList.remove(
            'bg-[var(--color-verde)]',
            'hover:bg-[var(--color-bordo)]'
          );

          btnCopiar.classList.add('bg-[var(--color-exito)]');

          setTimeout(() => {
            textoBtn.innerText = textoOriginal;

            btnCopiar.classList.remove(
              'bg-[var(--color-exito)]'
            );

            btnCopiar.classList.add(
              'bg-[var(--color-verde)]',
              'hover:bg-[var(--color-bordo)]'
            );
          }, 2500);

        } catch (err) {
          console.error('No se pudo copiar el texto:', err);
          textoBtn.innerText = 'Error al copiar';
        }
      });
    }
  });
</script>