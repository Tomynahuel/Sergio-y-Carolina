---
import "../styles/global.css";
import { BODA_INFO } from "../data/InfoBoda.js";

// WhatsApp
const numeroWhatsApp = BODA_INFO.whatsappContactoRegalos.replace(/\D/g, "");

const mensajeWhatsApp = encodeURIComponent(
  "¡Hola! Me encantaría ver la lista de regalos para la boda.",
);

const linkWhatsApp = `https://wa.me/${numeroWhatsApp}?text=${mensajeWhatsApp}`;
---

<section id="regalos" class="flex py-10">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Contenedor Maestro -->
    <div class="soft-card mx-auto w-full rounded-[36px] p-8 shadow-sm sm:p-12">
      <!-- ================================================= -->
      <!-- TÍTULO -->
      <!-- ================================================= -->

      <div class="mb-12 text-center">
        <h2 class="font-titulo text-4xl text-[var(--color-verde)] sm:text-5xl">
          Regalos
        </h2>
      </div>

      <!-- ================================================= -->
      <!-- GRILLA -->
      <!-- ================================================= -->

      <div
        class="mx-auto grid max-w-5xl grid-cols-1 items-stretch gap-10 text-center sm:gap-14 md:grid-cols-2"
      >
        <!-- ================================================= -->
        <!-- TARJETA 1: MESA DE REGALOS -->
        <!-- ================================================= -->

        <div
          class="soft-card relative flex h-full flex-col items-center justify-between overflow-hidden rounded-3xl border border-[var(--color-borde-suave)] p-8 shadow-sm transition-all duration-300 hover:scale-[1.03] hover:shadow-xl"
        >
          <div class="relative z-10 flex w-full flex-col items-center">
            <!-- Título -->
            <div class="mb-6">
              <h2
                class="font-titulo text-3xl text-[var(--color-texto)] sm:text-4xl"
              >
                Mesa de regalos
              </h2>
            </div>

            <!-- Icono -->
            <div
              class="mb-6 flex h-16 items-center justify-center text-[var(--color-bordo-rosa)]"
            >
              <svg
                class="h-12 w-12"
                fill="none"
                stroke="currentColor"
                stroke-width="0.85"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"
                ></path>
              </svg>
            </div>

            <!-- Descripción -->
            <p
              class="font-parrafo mb-8 max-w-sm text-lg leading-relaxed text-[var(--color-texto-suave)]"
            >
              Si preferís hacernos un presente físico, presioná el botón para
              conocer nuestra lista de regalos. ¡O también podés hacer un regalo
              económico a través de nuestro alias!
            </p>
          </div>

          <!-- ================================================= -->
          <!-- BOTÓN WHATSAPP -->
          <!-- ================================================= -->

          <a
            href={linkWhatsApp}
            target="_blank"
            rel="noopener noreferrer"
            class="font-destacado relative z-10 mt-auto w-full max-w-[220px] rounded-full bg-[var(--color-verde)] px-8 py-3 text-xs uppercase tracking-widest text-[var(--color-blanco)] transition-colors hover:bg-[var(--color-bordo)] hover:text-[var(--color-blanco)]"
          >
            Ver lista de regalos
          </a>
        </div>

        <!-- ================================================= -->
        <!-- TARJETA 2: DATOS BANCARIOS -->
        <!-- ================================================= -->

        <div
          class="relative flex h-full flex-col items-center justify-between overflow-hidden rounded-3xl border border-[var(--color-borde-suave)] p-8 shadow-sm transition-all duration-300 hover:scale-[1.03] hover:shadow-xl sm:p-10"
        >
          <!-- Contenido -->
          <div class="relative z-10 flex w-full flex-col items-center">
            <!-- ================================================= -->
            <!-- ICONO -->
            <!-- ================================================= -->

            <div
              class="mb-6 flex h-16 items-center justify-center text-[var(--color-bordo-rosa)]"
            >
              <svg
                class="h-14 w-14"
                fill="none"
                stroke="currentColor"
                stroke-width="0.85"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z"
                ></path>
              </svg>
            </div>

            <!-- ================================================= -->
            <!-- DATOS -->
            <!-- ================================================= -->

            <div class="mb-8 w-full max-w-sm text-center">
              <!-- Etiqueta -->
              <p
                class="font-destacado mb-3 text-[11px] uppercase tracking-[0.3em] text-[var(--color-rosa)]"
              >
                Alias
              </p>

              <!-- Alias -->
              <p
                id="alias-boda"
                class="font-palabra mb-4 text-xl uppercase tracking-wider text-[var(--color-texto-fuerte)] md:text-2xl"
              >
                {BODA_INFO.aliasBoda}
              </p>

              <!-- Separador -->
              <div
                class="mx-auto my-4 w-3/4 border-t border-dashed border-[var(--color-borde-suave)]"
              >
              </div>

              <!-- Dueño de la cuenta -->
              <p class="font-titulo mt-4 text-4xl text-[var(--color-texto)]">
                {BODA_INFO.dueñoCuenta}
              </p>
            </div>
          </div>

          <!-- ================================================= -->
          <!-- BOTÓN COPIAR -->
          <!-- ================================================= -->

          <button
            id="btn-copiar"
            class="font-destacado relative z-10 mt-auto flex w-full max-w-[240px] items-center justify-center gap-2 rounded bg-[var(--color-verde)] px-8 py-3 text-xs uppercase tracking-widest text-[var(--color-blanco)] shadow-sm transition-colors hover:bg-[var(--color-bordo)]"
          >
            <span id="texto-btn-copiar"> Copiar Datos </span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =======================================================
     SCRIPT PARA COPIAR ALIAS
     ======================================================= -->

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btnCopiar = document.getElementById("btn-copiar");
    const textoBtn = document.getElementById("texto-btn-copiar");
    const aliasBoda = document.getElementById("alias-boda");

    if (btnCopiar && aliasBoda && textoBtn) {
      btnCopiar.addEventListener("click", async () => {
        try {
          const textoACopiar = aliasBoda.innerText.trim();

          await navigator.clipboard.writeText(textoACopiar);

          const textoOriginal = textoBtn.innerText;

          textoBtn.innerText = "¡Alias Copiado!";

          btnCopiar.classList.remove(
            "bg-[var(--color-verde)]",
            "hover:bg-[var(--color-bordo)]",
          );

          btnCopiar.classList.add("bg-[var(--color-exito)]");

          setTimeout(() => {
            textoBtn.innerText = textoOriginal;

            btnCopiar.classList.remove("bg-[var(--color-exito)]");

            btnCopiar.classList.add(
              "bg-[var(--color-verde)]",
              "hover:bg-[var(--color-bordo)]",
            );
          }, 2500);
        } catch (err) {
          console.error("No se pudo copiar el texto:", err);

          textoBtn.innerText = "Error al copiar";
        }
      });
    }
  });
</script>
